<?php
// 복사해서 secret.php 를 만들고 실제 시크릿으로 교체:  cp secret.php.example secret.php
// ⚠️ sp-node 의 apps/api/.env  JWT_SECRET 과 반드시 "동일 값"이어야 함(HS256 대칭키).
//    secret.php 는 gitignore 대상(커밋 금지). 이 .example 만 추적.
if (!defined('_GNUBOARD_')) exit;

define('SPCB_JWT_SECRET', 'change-me-must-match-gnuboard-extend-secret');

// ── SmartSMT 연동 (docs/SMARTSMT_INTEGRATION.md §4.2) — 로그인 인계 spcb/sso/smartsmt.php ──
// SmartSMT 와 나눠 갖는 전용 비밀. sp-node 의 apps/api/.env  SMARTSMT_SHARED_SECRET 과 "동일 값".
// ⚠️ SPCB_JWT_SECRET 과 반드시 "다른 값"(같으면 인계 주소가 동작을 거부한다). 32자 이상, 개발·운영 따로.
// 비워 두면 인계 주소는 503 으로 답한다(연동 미설정).
define('SPCB_SMARTSMT_SECRET', '');
// 로그인 뒤 회원을 돌려보낼 SmartSMT 주소(환경별 1개). SmartSMT 가 알려 준 값을 넣는다.
define('SPCB_SMARTSMT_LOGIN_URL', '');
