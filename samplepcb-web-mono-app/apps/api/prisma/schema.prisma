// sp-node 소유 테이블(sp_ 접두) 스키마 — 그누보드와 **같은 DB(samplepcb)를 공유**한다
// (2026-07-03 통합: 백업 정합성·조인 단순화. DB 공유 ≠ 스키마 결합 — 소유권 규칙 유지).
// 그누보드 g5_* 는 Node 가 소유/수정하지 않는다 — 단 g5_shop_cart/옵션 행은
// 담기 API 의 한정 예외(HANDOFF 결정 로그 #6)로 Prisma 가 아닌 mysql2 로 수행.
//
// ⚠⚠ 공유 DB 이므로 `prisma migrate reset` **절대 금지** — 대상 DB 의 모든 테이블
// (그누보드 g5_* 포함)을 드랍한다.
// ⚠ `prisma migrate dev` 도 쓰지 말 것 — 이 DB 에선 g5_* 60개를 drift 로 감지해
// **항상 전체 reset 을 요구**한다(2026-07-04 실측, HANDOFF 결정 로그). 스키마 변경 절차:
// migrations/ 에 추가 전용(ALTER ADD·CREATE 만) migration.sql 수기 작성 → 눈 검수 →
// `prisma migrate deploy`(drift 감지·shadow DB 없음) → `prisma generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 견적 스냅샷 — 담기 시 가격 재검증의 단일 진실원본.
// quoteId 는 DB 저장 방식(서명 토큰 기각 — rfq 기록·감사·일괄 무효화 필요, HANDOFF 결정).
model SpQuote {
  id            String   @id @default(uuid()) // = quoteId
  category      String // 제품군: standard|metalMask|advance|flexible…
  orderCategory String // sample|mass
  qty           Int
  specJson      Json // 계산 입력 스냅샷
  specHash      String // 담기 시 변조 대조용 (spec 정규화 JSON 의 sha256)
  autoPrice     Int? // null = 자동견적 불가(rfq)
  eta           String? // 계산 시점 도착예정일 (표시용)
  priceVersion  String // 가격표 버전 (일괄 무효화용)
  expiresAt     DateTime // 발급 +72h
  createdAt     DateTime @default(now())
  // 관리자 사양 수정(P4.2) — 견적 스냅샷은 불변이라 수정할 때마다 **새 행**이 발급되고
  // spec.quoteId 가 옮겨간다. 그 체인이 곧 "언제 무엇이 바뀌었나"의 이력이므로 별도
  // 원장을 두지 않고, 체인이 답하지 못하는 **누가·왜**만 여기 두 칸으로 남긴다.
  // null = 고객이 만든 견적(최초 신청·재견적).
  revisedBy     String?  @db.VarChar(191) // 수정한 관리자 mb_id
  revisedReason String?  @db.Text

  @@map("sp_quote")
}

// 주문의 실체(= PCB 프로젝트). 영카트 상품/카트에는 스냅샷만 가고 사양은 여기 산다.
// cart 와의 관계(담김/주문됨)는 저장하지 않고 ct_id 조인으로 파생(HANDOFF 3장).
model SpOrderSpec {
  id            BigInt    @id @default(autoincrement()) // = projectId
  // mb_id 는 레거시가 이메일 아이디를 쓰며 255 로 확폭 운영 — sp 측은 utf8mb4 인덱스 한도(191) 채택 (2026-07-07)
  mbId          String?   @db.VarChar(191) // 비회원 null (목록 미노출)
  quoteId       String // sp_quote 연결
  ctId          Int? // g5_shop_cart 연결 (파생 조회 키)
  projectName   String
  category      String
  orderCategory String
  qty           Int
  message       String?   @db.MediumText // 레거시 it_basic 최대 ~1MB 실측 — TEXT(64KB) 절단 방지 (2026-07-07)
  companyName   String?   @db.VarChar(255) // 수신처 회사명 스냅샷(견적서 문서에 박제, 2층 구조의 문서층)
  specJson      Json
  status        String    @default("active") // active|deleted|archived
  quoteStatus   String // priced|rfq|quoted
  finalPrice    Int? // 관리자 확정가 (quoted)
  pricedBy      String?   @db.VarChar(191) // mb_id 계열(이메일 아이디 수용) — 2026-07-07 확폭
  pricedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pcbRfqs       SpPcbRfq[] // PCB 파트너 트랙(docs/PCB_PARTNER_TRACK.md) — 스펙 삭제 시 cascade
  pcbPos        SpPcbPo[]
  pcbShipments  SpPcbShipment[]
  pcbAsCases    SpPcbAsCase[]
  pcbClaims     SpPcbClaim[]

  @@index([mbId, status])
  @@index([quoteId])
  @@index([ctId]) // 레거시 이관·ct_id 조인(테마 뱃지/썸네일) 조회용 (2026-07-07)
  @@map("sp_order_spec")
}

// 파일 연결(폴리모픽) — 기존 운영 sp_file 스키마 준수(uploaded_by 는 varchar(20) 확정).
// 실파일은 file.samplepcb.kr 파일서버, 여기엔 pathToken 만.
model SpFile {
  id             BigInt   @id @default(autoincrement())
  refType        String   @map("ref_type") @db.VarChar(50) // 'sp_order_spec'
  refId          BigInt   @map("ref_id")
  uploadFileName String   @map("upload_file_name") @db.VarChar(255)
  originFileName String   @map("origin_file_name") @db.VarChar(255)
  pathToken      String   @map("path_token") @db.VarChar(500)
  size           BigInt   @default(0)
  writeDate      DateTime @map("write_date")
  fileType       String?  @map("file_type") @db.VarChar(50) // gerber|thumbnail|bom|drawing
  uploadedBy     String?  @map("uploaded_by") @db.VarChar(20) // ADMIN|PARTNER|…

  @@index([refType, refId], map: "idx_sp_file_ref")
  @@map("sp_file")
}

// 회원별 견적 기본값(2층 구조의 프로필층) — 관리자가 회사명을 저장하면 기억해
// 같은 회원의 다음 견적서에 프리필한다. 그누보드 여분필드(mb_1/mb_2)를 쓰지 않기
// 위한 sp측 명시 필드(2026-07-04 결정). 사용자측 신청 폼 수집은 다음 단계.
//
// 2026-07-07 레거시 마이그레이션 확장: 레거시 g5_member 여분/커스텀 필드를 명시 컬럼으로
// 승격(라벨 정본 = 계약 AdminMemberBusiness · 레거시 theme/samplepcb/member_info.php).
// mb_1→memberType(정규화) · mb_2→companyName · mb_3→bizNo · mb_4→ceoName · mb_5→bizType(업태)
// · mb_6→bizItem(종목) · mb_7→managerName · mb_8→taxEmail · mb_9→managerPhone · mb_10~12→
// bizZip/bizAddr1/bizAddr2 · mb_13→partnerKind · mb_15→managerEmail · mb_partner_auth→partnerAuth.
// 정규화 전 원본(mb_1 raw)·저사용 잔여 커스텀(mb_14/16~20 JSON, 계좌 6컬럼 등)은 legacyJson 보존.
model SpMemberProfile {
  mbId         String   @id @db.VarChar(191) // mb_id 계열(이메일 아이디 수용) — 2026-07-07 확폭
  companyName  String?  @db.VarChar(255)
  memberType   String?  @db.VarChar(20) // personal|corporate|partner (mb_1 정규화)
  bizNo        String?  @db.VarChar(50) // 사업자등록번호
  ceoName      String?  @db.VarChar(255) // 대표자
  bizType      String?  @db.VarChar(255) // 업태
  bizItem      String?  @db.VarChar(255) // 종목
  managerName  String?  @db.VarChar(255) // 담당자명
  taxEmail     String?  @db.VarChar(255) // 세금계산서 이메일
  managerPhone String?  @db.VarChar(50) // 담당자 전화
  managerEmail String?  @db.VarChar(255) // 담당자 이메일 (레거시 mb_15)
  bizZip       String?  @db.VarChar(100) // 사업장 우편번호(레거시 오염: 주소 문자열 실재 최대 35자 — 보존 확폭)
  bizAddr1     String?  @db.VarChar(255) // 사업장 주소
  bizAddr2     String?  @db.VarChar(255) // 사업장 상세주소
  partnerKind  String?  @db.VarChar(100) // 파트너 종류 (레거시 mb_13)
  partnerAuth  Int      @default(0) // 파트너 인증 등급 0=미인증/1=A/2=B/3=C/4=부품판매
  legacyJson   Json? // 잔여 레거시 커스텀 원본 보존(mb_1 raw·mb_14/16~20·계좌 등)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sp_member_profile")
}

// 주문별 세금계산서 발행 정보 — 레거시 g5_shop_order od_1~od_11(주문서 "세금계산서" 섹션,
// 무통장 한정 입력) 이관처. 신규 주문 경로의 수집 폼 연결은 후속 과제(계획 문서 참조).
// od_12~17 은 레거시에서도 미사용 확정이라 승격하지 않는다.
model SpOrderBizInfo {
  odId        String   @id @db.VarChar(30) // g5_shop_order.od_id (FK 아님 — 공유 DB 조인 키)
  companyName String?  @db.VarChar(255) // od_1 회사명
  bizNo       String?  @db.VarChar(50) // od_2 사업자등록번호
  ceoName     String?  @db.VarChar(255) // od_3 대표자 성명
  bizType     String?  @db.VarChar(255) // od_4 업태
  bizItem     String?  @db.VarChar(255) // od_5 종목
  managerName String?  @db.VarChar(255) // od_6 담당자명
  taxEmail    String?  @db.VarChar(255) // od_7 세금계산서 이메일
  companyTel  String?  @db.VarChar(50) // od_8 회사전화
  bizZip      String?  @db.VarChar(20) // od_9 사업장 우편번호
  bizAddr1    String?  @db.VarChar(255) // od_10 사업장 기본주소
  bizAddr2    String?  @db.VarChar(255) // od_11 사업장 상세주소
  createdAt   DateTime @default(now())

  @@map("sp_order_biz_info")
}

// 상품 별점후기 — 레거시 영카트 g5_shop_item_use(상품 사용후기=별점평가) 이관처.
// 레거시는 후기를 "거버 제출건별 상품(it_id)"에 붙였으나, 신규는 상품이 4종 템플릿뿐이라
// 후기를 주문/프로젝트(sp_order_spec) 단위로 재귀속한다: it_id → 레거시 cart 라인(od,ct) →
// quoteId=uuidV5("od:ct") → sp_order_spec.quoteId (05-reviews.ts, 2026-07-09).
// - is_password(회원 비번 해시 사본)는 어떤 형태로도 저장하지 않는다(보안).
// - _legacy 혼합 저장 금지 — legacyJson 분리(SpMemberProfile 관례, 직렬화 500 전례 회피).
model SpReview {
  id           BigInt    @id @default(autoincrement())
  legacyIsId   Int?      @unique // 레거시 is_id — 증분 sync 멱등 upsert 키(신규 후기는 null)
  mbId         String    @db.VarChar(191) // 작성자(=주문자). 필수 저장
  quoteId      String? // sp_order_spec.quoteId 귀속(매핑 실패 시 null — 데이터 보존)
  specId       BigInt? // sp_order_spec.id 부가 캐시(정본은 quoteId)
  score        Int // is_score 1~5
  subject      String?   @db.VarChar(255) // is_subject
  content      String    @db.Text // is_content
  isConfirm    Int       @default(0) // is_confirm 노출 승인 게이트(증분에서 0 가능)
  replySubject String?   @db.VarChar(255) // is_reply_subject(관리자 답변)
  replyContent String?   @db.Text // is_reply_content
  replyName    String?   @db.VarChar(50) // is_reply_name(관리자 mb_nick)
  repliedAt    DateTime? // 레거시 답변시각 컬럼 부재 → 이관분 항상 null
  writeDate    DateTime // is_time
  legacyItId   String?   @db.VarChar(20) // 원본 it_id(매핑 실패 조사·감사)
  legacyJson   Json? // is_ip 등 잔여 원본(is_password 는 절대 제외)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([quoteId])
  @@index([mbId])
  @@map("sp_review")
}

// ── PCB 재능마켓 (sp_market_*, 2026-07-08 1차=매칭까지) ─────────────────────
// 회원 = 그누보드(g5_member). mbId 는 JWT 클레임 유래 문자열 — FK 금지(공유 DB 조인 키).
// 분야/CAD 등 코드 사전은 @sp/api-contract 의 MARKET_* 상수가 정본, 여기엔 코드만 저장.
// 상태값은 String + 앱단 리터럴 유니온(asXxx 내로잉) — 기존 sp_* 관례(enum 미사용).
// 첨부·증빙 파일은 sp_file 폴리모픽 재사용(refType='sp_market_project'|'sp_market_expert').

// 전문가 프로필 — 회원당 1행(mbId unique). 관리자 승인 워크플로 포함.
// expertType: individual(개인·지정3번)|company(기업·지정2번)|house(당사·지정1번, 시드 1행).
// status: pending|approved|rejected|suspended.
model SpMarketExpert {
  id               BigInt    @id @default(autoincrement())
  mbId             String    @unique @db.VarChar(191) // mb_id 계열(이메일 아이디 수용)
  expertType       String    @db.VarChar(20)
  displayName      String    @db.VarChar(100) // 이름(개인)/상호(기업) — 공개 프로필 비마스킹
  phone            String    @db.VarChar(50)
  identityVerified Boolean   @default(false) // 1차: 관리자 심사 화면 수동 체크(실인증 연동 2차)
  careerRange      String    @db.VarChar(20) // 경력 구간 코드
  contactHours     String?   @db.VarChar(100) // 통화 가능시간(자유 입력)
  region           String?   @db.VarChar(20) // 활동 지역 코드
  travelRange      String?   @db.VarChar(20) // 이동 가능 거리 코드
  intro            String?   @db.Text
  serviceAreas     Json // 제공 가능한 개발 영역 코드 배열
  categories       Json // 회로개발 세부분야 코드 배열
  cadTools         Json // CAD 툴 코드 배열
  bankName         String?   @db.VarChar(50) // 정산계좌(2차 정산 대비 수집) — 본인·관리자 외 비노출
  bankHolder       String?   @db.VarChar(50)
  bankAccount      String?   @db.VarChar(50)
  termsAgreedAt    DateTime // 약관 + 프로필 공개 동의 시각
  status           String    @default("pending") @db.VarChar(20)
  statusReason     String?   @db.VarChar(255) // 반려/정지 사유
  decidedBy        String?   @db.VarChar(191) // 처리 관리자 mbId
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status]) // 관리자 심사 탭
  @@map("sp_market_expert")
}

// 프로젝트 의뢰 — method: open(역견적=공개 블라인드 입찰)|targeted(지정견적=1:1).
// status: bidding|closed|awarded|cancelled (2차 예약: working|completed).
// 마감은 cron 없는 lazy 파생 — bidDeadlineAt vs now 비교(읽기 응답·쓰기 가드 동일 식).
model SpMarketProject {
  id                       BigInt    @id @default(autoincrement())
  mbId                     String    @db.VarChar(191) // 의뢰인 — 공개 응답엔 maskName 값만 나간다
  title                    String    @db.VarChar(200)
  requestType              String    @map("category") @db.VarChar(30) // system|individual
  serviceAreas             Json // 실제 필요한 개발 영역 코드 배열(복수)
  // 물리명 specialties — 인접 물리 컬럼 category(=requestType)와 category/categories 혼동 회피.
  categories               Json      @map("specialties") // 세부분야 코드 배열(회로·펌웨어 STEP2)
  cadTools                 Json // 요구 툴 코드 배열(ECAD·MCAD·디자인 통합) — 빈 배열=무관, 'any' 는 레거시
  description              String    @db.Text
  // AI 생성 시스템 구성도(단일 HTML) — 공개 범위는 description 과 동일(설명에서 파생).
  // 렌더는 반드시 sandbox iframe(srcdoc) — LLM 출력이라 DOM 직결 금지.
  diagramHtml              String?   @db.MediumText
  // 구성 명세 JSON(DiagramSpec 직렬화) — 구성도의 원천 데이터. 재생성과 후속 문서
  // (ROC·포스팅 요약) 파생의 근원이라 HTML 과 별도로 보존한다.
  diagramSpec              String?   @db.MediumText
  // AI 작업검토지시서 마크다운(Phase 2) — 공개 범위는 description 과 동일.
  rocMd                    String?   @db.MediumText
  // 인터뷰 답변 원본([{code,answer}]) — 응답 미노출 저장 전용, 명세·문서 재생성의 근원.
  interviewAnswers         Json?
  // 신규 등록에서 원본 답변의 견적 가능 전문가 공개를 명시 동의한 시각. null인 기존 건은
  // 어떤 신규 응답에도 답변을 싣지 않아 과거 비공개 정책을 소급 변경하지 않는다.
  interviewAnswersSharedAt DateTime?
  // 분야별 포스팅 카드(Phase 3, MarketPostingCards) — 공개 범위는 description 과 동일.
  postings                 Json?
  // AI 잡 출처와 결정적 렌더 출처의 검증 메타데이터. 모델·프롬프트/입력/출력 해시·jobId를
  // 보존하며, 실제 산출물과 해시가 다르면 응답 라벨을 고객 수정본으로 내린다.
  aiGenerationMeta         Json?
  ndaRequired              Boolean   @default(true) // 프로젝트 단위 NDA 게이트(첨부 일괄)
  budgetRange              String    @db.VarChar(20) // 예산 구간 코드(금액 아님)
  startHopeDate            String?   @db.VarChar(10) // 'YYYY-MM-DD' 표시용 KST 날짜 문자열(타임존 경계 회피)
  dueHopeDate              String?   @db.VarChar(10)
  bidDeadlineAt            DateTime // 견적 마감 절대 시각(서버 계산: 3/7/14일 프리셋 or 지정일 23:59:59 KST)
  method                   String    @db.VarChar(20)
  targetExpertId           BigInt? // 지정견적 대상(sp_market_expert.id) — open 이면 null
  status                   String    @default("bidding") @db.VarChar(20)
  awardedBidId             BigInt? // 채택 입찰 — 2차 계약(sp_market_contract)의 연결 근원
  awardedAt                DateTime?
  viewCount                Int       @default(0) // 원자 +1(소유자/관리자 제외), dedup 없음(1차)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, bidDeadlineAt]) // 공개 목록(입찰중 WHERE + lazy 마감 + 마감순 정렬)
  @@index([mbId]) // 내 의뢰 목록
  @@index([targetExpertId]) // 지정견적 인박스(전문가별)
  @@map("sp_market_project")
}

// 입찰(견적 제출) — 블라인드: 소유자·관리자만 전체, 전문가는 자기 것만, 공개는 개수만.
// status: submitted|awarded|rejected|withdrawn. 재제출=같은 행 수정(unique 유지).
model SpMarketBid {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt
  expertId     BigInt // sp_market_expert.id
  mbId         String   @db.VarChar(191) // 전문가 mbId 복제 — 소유 판정·내 입찰을 무조인으로
  amount       Int // 원 단위 KRW(프로토타입의 만원 단위를 정규화)
  durationDays Int
  warranty     String?  @db.VarChar(255) // 하자보수 문구
  message      String   @db.Text // 제안 메시지
  status       String   @default("submitted") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt // 재제출 최종 시각

  @@unique([projectId, expertId]) // 전문가당 1입찰(중복 제출 레이스의 최종 방어선)
  @@index([projectId, status]) // 비교 목록·채택 일괄 전이·bidCount 집계
  @@index([mbId]) // 내 입찰 목록
  @@map("sp_market_bid")
}

// NDA 전자서명 — 프로젝트 단위 1인 1서명(재서명 요청은 멱등). 문구 원문은 계약
// (MARKET_NDA_TEXT)이 버전 관리하고 여기엔 textVersion 만 저장.
model SpMarketNdaSign {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt
  mbId        String   @db.VarChar(191) // 서명자(승인 전문가)
  textVersion String   @db.VarChar(20)
  signedName  String   @db.VarChar(100) // 서명 시 입력 성명(회원 탈퇴 후 감사 대비 스냅샷)
  ip          String   @db.VarChar(45) // IPv6 수용
  createdAt   DateTime @default(now())

  @@unique([projectId, mbId]) // 중복 방지 + 서명 여부 판정 키
  @@map("sp_market_nda_sign")
}

// 마켓 설정 싱글턴(id=1) — g5_shop_default 는 영카트 소유라 마켓 설정을 섞지 않는다.
// 행 부재 시 GET 은 기본값 폴백, PATCH 가 upsert(id=1) — 시드 불요.
model SpMarketSettings {
  id        Int      @id @default(1)
  feeRateBp Int      @default(1000) // 전문가측 수수료율 basis point(1000=10.00%)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sp_market_settings")
}

// 계약(2차: 결제·검수·정산) — 채택(award) tx 에서 프로젝트당 1건 생성(projectId unique,
// unaward 없음 모델). fee/payout 은 채택 시점 스냅샷. status: pending|paid|delivered|
// completed|settled|cancelled. paid 승격은 cron 없는 lazy write-back(od·카트 라인 대조).
// 산출물 파일은 sp_file 재사용(refType='sp_market_contract', fileType='deliverable').
model SpMarketContract {
  id              BigInt    @id @default(autoincrement())
  projectId       BigInt    @unique // 프로젝트당 1계약(unaward 없음 모델)
  bidId           BigInt // 채택 입찰(sp_market_bid.id)
  clientMbId      String    @db.VarChar(191) // 의뢰인 — 복제(무조인 소유 판정)
  expertMbId      String    @db.VarChar(191) // 채택 전문가 — 복제(무조인 소유 판정)
  expertId        BigInt // sp_market_expert.id
  amount          Int // 입찰액 = VAT 포함 총액(수수료도 총액 기준)
  feeRateBp       Int // 수수료율 bp — 채택 시점 스냅샷
  feeAmount       Int // round(amount×bp/10000) — 채택 시점 스냅샷
  payoutAmount    Int // amount − feeAmount — 채택 시점 스냅샷
  contractKey     String    @unique @db.VarChar(36) // uuid v4 = 영카트 io_id·주문 라인 식별자
  ctId            Int? // g5_shop_cart.ct_id — checkout 주입/재주입 시 갱신
  status          String    @default("pending") @db.VarChar(20) // pending|paid|delivered|completed|settled|cancelled
  paidAt          DateTime?
  paidOdId        String?   @db.VarChar(20) // 승격 근거 주문(g5_shop_order.od_id)
  deliveredAt     DateTime?
  deliveryNote    String?   @db.Text // 납품 보고 노트(재보고 시 갱신)
  completedAt     DateTime?
  confirmedBy     String?   @db.VarChar(10) // client|auto
  holdAt          DateTime? // 관리자 자동확정 정지 시각(있으면 auto 승격 정지)
  holdReason      String?   @db.VarChar(500)
  settledAt       DateTime?
  settledBy       String?   @db.VarChar(191) // 정산 처리 관리자 mbId
  settleNote      String?   @db.VarChar(500)
  cancelledAt     DateTime?
  cancelReason    String?   @db.VarChar(500)
  // 입찰 채택 시점의 의뢰 조건·AI 산출물·공개 동의 답변·채택 견적 전체 스냅샷.
  // 원 프로젝트가 유지되더라도 분쟁 감사 기준을 계약 행에 고정한다.
  requestSnapshot Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status]) // 관리자 계약 목록 탭 + delivered 자동확정 스윕
  @@index([clientMbId]) // 내 의뢰 계약
  @@index([expertMbId]) // 내 작업 계약
  @@map("sp_market_contract")
}

// ── SEO 메타 (sp_seo, 2026-07-10 P1) ───────────────────────────────────────
// 영카트/그누보드 코어엔 페이지별 SEO 가 없다(cf_title 전역 접미사 + cf_add_meta 전역
// raw 1벌뿐). 관리=sp-vue(/app/admin/seo)→sp-node→여기, 소비=sp-php 테마 head.sub.php 가
// 페이지 전역변수(스크립트 basename + $it/$bo_table) 매칭으로 1쿼리 직접 SELECT(read-only).
// 정본: docs/SEO_MANAGEMENT.md. 폴백: 엔티티 오버라이드 → scope 기본 → global 기본 → 코어 cf_title.
// og:title/이미지·Product JSON-LD 는 $it 에서 자동 유도가 기본이고 이 레코드는 오버라이드용.
// canonical 은 저장 아닌 계산(G5_DOMAIN='' 호스트 무관 설계) — 여기 값은 수동 오버라이드만.
model SpSeo {
  id              BigInt   @id @default(autoincrement())
  scope           String   @db.VarChar(20) // global|item|board|page
  refKey          String   @default("") @db.VarChar(191) // global='' · item=it_id · board=bo_table · page=basename/경로
  metaTitle       String?  @db.VarChar(255) // <title> 오버라이드(빈값이면 자동/코어 title)
  metaDescription String?  @db.VarChar(500) // meta description
  ogImage         String?  @db.VarChar(500) // OG 이미지(상대경로 저장 가능 — 소비측이 절대 URL 화)
  canonical       String?  @db.VarChar(500) // 수동 오버라이드만(기본은 host+path 계산)
  robots          String?  @db.VarChar(50) // 예: noindex,nofollow (null=기본 index,follow)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope, refKey]) // (scope,ref)당 1레코드 — upsert 키
  @@map("sp_seo")
}

// sp-node 범용 설정(key-value 싱글턴 스토어) — 코어 g5_config/g5_shop_default 를 건드리지
// 않는 sp 소유 설정. gerber_price_mode · ai_base_url · ai_api_key(관리자 외 원문 비노출).
model SpConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("sp_config")
}

// AI 유스케이스 설정 — 연결(sp_config ai_*)과 분리된 유스케이스 단위(활성·모델·프롬프트).
// 행은 서버가 레지스트리(lib/ai/usecases.ts) 기준으로 lazy 생성. 현재 market.request-diagram 1종.
model SpAiUsecase {
  useCase        String   @id @db.VarChar(100)
  enabled        Boolean  @default(false)
  model          String   @db.VarChar(100)
  promptTemplate String   @db.Text
  updatedAt      DateTime @updatedAt

  @@map("sp_ai_usecase")
}

// ── 부품 카탈로그 (BOM 공급사 검색 자동 인제스트, docs/PARTS_SEARCH.md) ──────
// DB=진실원본, ES(sp-parts)=재구축 가능한 검색 파생물. 카탈로그는 사실 데이터이며
// BOM 매칭 상태(VERIFIED 등 문맥)는 저장하지 않는다.

// 정규 부품 1행 — 공급사 무관. upsert 키 = (mpnNorm, manufacturerNorm).
model SpPart {
  id               BigInt        @id @default(autoincrement())
  mpn              String        @db.VarChar(191) // 원문 MPN(표시용)
  mpnNorm          String        @db.VarChar(191) // 대문자·영숫자만(@sp/utils normalizeMpn)
  manufacturerName String        @db.VarChar(191) // 별칭 해소 후 정준 표시명
  manufacturerNorm String        @db.VarChar(191) // 소문자·영숫자만
  description      String?       @db.Text
  category         String?       @db.VarChar(191)
  packageCode      String?       @db.VarChar(32) // 임페리얼 정준(0402) 또는 원문 대문자
  lifecycle        String?       @db.VarChar(64)
  datasheetUrl     String?       @db.VarChar(500)
  imageUrl         String?       @db.VarChar(500) // 공급사 제품 사진 직링크(정본 — 신뢰순 대표 1개)
  specsJson        Json // 공급사 normalized_specs 병합(표시용 — dielectric·온도범위 포함)
  specsSi          Json // SI 정준 수치만(resistanceOhm 등 SPEC_SI_FIELD 키) — ES 색인 원천
  specConflicts    Json? // 공급사 간 스펙 실충돌 기록 {field:[{value,suppliers,fetchedAt}]} — null=충돌 없음
  firstSeenAt      DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  indexedAt        DateTime? // 마지막 ES 색인 성공 시각(null=미색인)
  factsFingerprint String?       @db.Char(64) // 전체 실공급사 구매 조건+정본 정책 fingerprint
  indexFingerprint String?       @db.Char(64) // 마지막 성공 ES 문서+색인 정책 fingerprint
  offers           SpPartOffer[]

  @@unique([mpnNorm, manufacturerNorm])
  @@index([lastSeenAt])
  @@map("sp_part")
}

// 공급사별 판매 정보 — 공급사 추가는 supplier 값 추가일 뿐(스키마 무변경).
model SpPartOffer {
  id                 BigInt             @id @default(autoincrement())
  partId             BigInt
  supplier           String             @db.VarChar(32) // mouser|digikey|unikeyic|…
  supplierSku        String             @default("") @db.VarChar(191) // null 공급사는 '' 로 정규화(unique 안정)
  productUrl         String?            @db.VarChar(1000)
  stock              Int?
  moq                Int?
  orderMultiple      Int?
  packaging          String?            @db.VarChar(64)
  currency           String?            @db.VarChar(8) // 대표 통화(프라이스브레이크 첫 행)
  leadTime           String?            @db.VarChar(64)
  rawJson            Json // 공급사 원본 product payload — 감사·재처리용
  fetchedAt          DateTime
  contentFingerprint String?            @db.Char(64) // fetchedAt 제외 저장 내용+인제스트 정책 fingerprint
  part               SpPart             @relation(fields: [partId], references: [id], onDelete: Cascade)
  priceBreaks        SpPartPriceBreak[]

  @@unique([partId, supplier, supplierSku])
  @@index([supplier])
  @@map("sp_part_offer")
}

// 수량 구간 단가 — fetch 단위 replace-all.
model SpPartPriceBreak {
  id       BigInt      @id @default(autoincrement())
  offerId  BigInt
  qty      Int
  price    Decimal     @db.Decimal(14, 6)
  currency String      @default("") @db.VarChar(8)
  offer    SpPartOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, qty])
  @@map("sp_part_price_break")
}

// ES 색인 실패 재시도 큐 — DB 쓰기는 성공했으나 색인이 실패한 부품. 기동 시·주기 drain.
model SpPartIndexQueue {
  id       BigInt   @id @default(autoincrement())
  partId   BigInt
  reason   String   @db.VarChar(191)
  attempts Int      @default(0)
  queuedAt DateTime @default(now())

  @@index([partId])
  @@map("sp_part_index_queue")
}

// 동일 공급사 결과의 중복 인제스트를 서버 재시작·다중 인스턴스에서도 한 번으로 수렴시키는 원장.
// fingerprint에는 실제 카탈로그 입력과 정책 버전이 들어가며, 원본 BOM 파일 해시는 사용하지 않는다.
model SpPartIngestRun {
  id                 BigInt                   @id @default(autoincrement())
  fingerprint        String                   @unique @db.Char(64)
  policyVersion      String                   @db.VarChar(64)
  sourceJobId        String?                  @db.VarChar(64)
  status             String                   @default("queued") @db.VarChar(16) // queued|running|completed|failed
  leaseUntil         DateTime?
  stats              Json?
  timing             Json?
  error              String?                  @db.VarChar(500)
  createdAt          DateTime                 @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime                 @updatedAt
  supplierSearchRuns SpBomSupplierSearchRun[]

  @@index([status, createdAt])
  @@map("sp_part_ingest_run")
}

// 고객 스마트 BOM 견적 — 업로드→파싱→매칭→검토→견적요청(RFQ). 설계: docs/BOM_QUOTE.md.
// xpse 의 sp_bom_document/sp_estimate_document(별도 DB)와 무관한 sp-node 소유 신규 모델.
// 금액 필드는 "예상 스냅샷"(sp_config 기본값·서버 재계산) — 확정은 confirmed* 로 분리.
model SpBomQuote {
  id                        BigInt                     @id @default(autoincrement())
  mbId                      String                     @db.VarChar(60)
  title                     String                     @db.VarChar(191)
  sourceKind                String                     @default("upload") @map("source_kind") @db.VarChar(16) // upload|single_search
  // 단일검색 견적 바구니는 회원당 활성 draft 한 건만 허용한다. 견적요청 시 null로 비워
  // 새 바구니를 만들 수 있게 하고, 과거 요청 견적에는 키를 남기지 않는다.
  activeSearchCartKey       String?                    @unique @map("active_search_cart_key") @db.VarChar(60)
  status                    String                     @default("draft") @db.VarChar(16) // draft|requested|reviewing|answered|closed|canceled
  fileName                  String?                    @db.VarChar(255)
  contentHash               String?                    @db.VarChar(64) // 원본 SHA-256 — 동일 파일 안내용
  engineJobId               String?                    @db.VarChar(64) // 엔진 인메모리 잡 — 재시작 시 소멸(재업로드)
  activeAnalysisRunId       BigInt?                    @unique @map("active_analysis_run_id")
  activeSupplierSearchRunId BigInt?                    @unique @map("active_supplier_search_run_id")
  buildStatus               String                     @default("ready") @db.VarChar(12) // parsing|selecting|building|ready|failed
  procurementMode           String                     @default("sample") @db.VarChar(8) // sample|mass — 엔진 조달 정책
  // 영카트 주문 전환(D16) — g5_shop_cart 파생 조인 키(거버 sp_order_spec.ctId 관례).
  // 주문·결제 상태는 저장하지 않고 ct/od 조인으로 파생한다(g5 미러 금지 D10).
  ctId                      Int?
  setQty                    Int                        @default(1)
  spareQty                  Int                        @default(0)
  itemsTotal                Int                        @default(0) // KRW 정수(반올림)
  shippingFee               Int                        @default(0)
  managementFee             Int                        @default(0)
  finalTotal                Int                        @default(0)
  usdKrwRateUsed            Decimal?                   @db.Decimal(10, 2)
  exchangeRateSnapshot      Json? // 적용 환율의 출처·기준일·안전계수(RFQ 감사 스냅샷)
  uncostedCount             Int                        @default(0)
  customerMemo              String?                    @db.Text
  adminMemo                 String?                    @db.Text // 내부 메모 — 고객 응답 미노출
  answerNote                String?                    @db.Text // 고객 노출 회신
  confirmedShippingFee      Int?
  confirmedManagementFee    Int?
  confirmedTotal            Int?
  enrichStatus              String                     @default("idle") @db.VarChar(12) // idle|searching|done|failed — 자동 보강 생명주기(단일 진실)
  enrichedAt                DateTime? // 마지막 보강 반영(재매칭 저장) 시각
  requestedAt               DateTime?
  answeredAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  items                     SpBomQuoteItem[]
  sheets                    SpBomQuoteSheet[]
  candidates                SpBomQuoteCandidate[]
  selectionEvents           SpBomQuoteSelectionEvent[]
  itemReviews               SpBomQuoteItemReview[]
  rfqs                      SpBomRfq[]
  pos                       SpBomPo[]
  analysisRuns              SpBomAnalysisRun[]         @relation("BomQuoteAnalysisRuns")
  activeAnalysisRun         SpBomAnalysisRun?          @relation("BomQuoteActiveAnalysis", fields: [activeAnalysisRunId], references: [id], onDelete: SetNull)
  supplierSearchRuns        SpBomSupplierSearchRun[]   @relation("BomQuoteSupplierSearchRuns")
  activeSupplierSearchRun   SpBomSupplierSearchRun?    @relation("BomQuoteActiveSupplierSearch", fields: [activeSupplierSearchRunId], references: [id], onDelete: SetNull)

  @@index([mbId, status])
  @@index([mbId, sourceKind, status])
  @@index([status, requestedAt])
  @@index([ctId])
  @@map("sp_bom_quote")
}

// 배송·완료 후 고객 문제 접수 원장(D37). 영카트 주문/카트 상태를 되돌리지 않고
// 누락·파손·오배송·품질 문제의 운영 대응만 별도 생명주기로 관리한다. quoteId/ctId는
// 의도적으로 느슨한 참조다. Case를 강제 삭제해도 이미 접수된 고객 대응 기록과 주문
// 스냅샷은 보존하며, activeKey unique가 같은 주문행의 미처리 중복 접수를 막는다.
model SpBomClaim {
  id              BigInt            @id @default(autoincrement())
  quoteId         BigInt
  quoteTitle      String            @db.VarChar(191)
  mbId            String            @db.VarChar(60)
  odId            String            @db.VarChar(64)
  ctId            Int
  activeKey       String?           @unique @db.VarChar(96)
  status          String            @default("open") @db.VarChar(16) // open|reviewing|resolved|rejected
  kind            String            @db.VarChar(24) // missing|damaged|wrong_part|quality|other
  subject         String            @db.VarChar(191)
  description     String            @db.Text
  orderSnapshot   Json
  version         Int               @default(1)
  adminMbId       String?           @db.VarChar(191)
  adminResponse   String?           @db.Text
  resolutionKind  String?           @db.VarChar(24) // replacement|refund_coordination|credit|guidance
  submittedAt     DateTime          @default(now())
  reviewStartedAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           SpBomClaimItem[]
  events          SpBomClaimEvent[]

  @@index([quoteId, submittedAt])
  @@index([mbId, submittedAt])
  @@index([status, submittedAt])
  @@map("sp_bom_claim")
}

// 접수 시점의 MPN·제조사·주문수량을 박제한다. 원 견적 품목은 이후 Case 삭제와 무관하게
// 느슨한 quoteItemId로만 추적하고, 화면·감사에는 아래 스냅샷을 사용한다.
model SpBomClaimItem {
  id               BigInt     @id @default(autoincrement())
  claimId          BigInt
  quoteItemId      BigInt
  mpn              String     @db.VarChar(191)
  manufacturerName String?    @db.VarChar(191)
  description      String?    @db.Text
  orderedQty       Int
  affectedQty      Int
  createdAt        DateTime   @default(now())
  claim            SpBomClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, quoteItemId])
  @@index([quoteItemId])
  @@map("sp_bom_claim_item")
}

// 클레임 상태 전이 append-only 감사 이력. 현재 상태는 claim.status가 조회 정본이고,
// 이 원장은 누가 언제 어떤 답변으로 전이했는지 재구성하는 근거다.
model SpBomClaimEvent {
  id         BigInt     @id @default(autoincrement())
  claimId    BigInt
  action     String     @db.VarChar(24) // submitted|review_started|resolved|rejected
  actorRole  String     @db.VarChar(12) // customer|admin
  actorMbId  String     @db.VarChar(191)
  fromStatus String?    @db.VarChar(16)
  toStatus   String     @db.VarChar(16)
  note       String?    @db.Text
  createdAt  DateTime   @default(now())
  claim      SpBomClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("sp_bom_claim_event")
}

// 관리자 Case 영구 삭제의 최소 감사 원장. 삭제 대상과 FK를 맺으면 cascade로 함께
// 사라지므로 quoteId는 의도적으로 느슨한 참조다. "감사기록 없이 초기화" 모드는
// 이 행을 만들지 않는다(서버/DB 백업·외부 메일 흔적까지 없음을 뜻하지는 않음).
// 영구(하드) 삭제 감사 원장 — **트랙 횡단 공용**(sp_ 접두사만 = 횡단 관례).
// 삭제 대상과 FK 를 두지 않아 강제 삭제 뒤에도 감사행만 남는다. "감사기록 없이
// 초기화" 모드는 애플리케이션이 행을 만들지 않는다.
// ⚠ 범위는 테이블 이름이 아니라 subjectType 이 말한다 — 회원·주문 삭제가 붙어도
//   이름을 다시 바꾸지 않는다(sp_mail_log 가 이름만 공용이고 quoteId 에 묶인 반면교사).
model SpDeleteAudit {
  id            BigInt   @id @default(autoincrement())
  subjectType   String   @db.VarChar(24) // bom_case | pcb_case (확장: member | order …)
  subjectId     String   @db.VarChar(64) // BigInt·UUID·od_id(varchar) 를 모두 담게 문자열
  title         String   @db.VarChar(191)
  mbId          String   @db.VarChar(60) // 대상 소유자
  subjectStatus String   @db.VarChar(16) // 삭제 시점 상태
  actorMbId     String   @db.VarChar(191)
  actorIp       String   @db.VarChar(64)
  reason        String   @db.Text
  snapshot      Json
  createdAt     DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([actorMbId, createdAt])
  @@map("sp_delete_audit")
}

// BOM 추출 실행 — sp-engine은 계산 서비스이며, 완료 결과의 영속 단일 진실은 sp-node가 소유한다.
// 실행은 append-only이고 quote.activeAnalysisRunId만 성공한 최신 실행으로 원자 전환한다.
model SpBomAnalysisRun {
  id                 BigInt                   @id @default(autoincrement())
  quoteId            BigInt
  engineJobId        String?                  @db.VarChar(64)
  engine             String                   @db.VarChar(32)
  schemaVersion      String                   @db.VarChar(32)
  parserVersion      String                   @db.VarChar(191)
  sourceFile         String                   @db.VarChar(255)
  engineModel        String?                  @db.VarChar(191)
  promptVersion      String?                  @db.VarChar(191)
  status             String                   @db.VarChar(16) // completed|failed
  summary            Json
  headers            Json
  failures           Json
  createdAt          DateTime                 @default(now())
  completedAt        DateTime?
  quote              SpBomQuote               @relation("BomQuoteAnalysisRuns", fields: [quoteId], references: [id], onDelete: Cascade)
  activeForQuote     SpBomQuote?              @relation("BomQuoteActiveAnalysis")
  sheets             SpBomAnalysisSheet[]
  components         SpBomAnalysisComponent[]
  supplierSearchRuns SpBomSupplierSearchRun[]

  @@index([quoteId, createdAt])
  @@map("sp_bom_analysis_run")
}

// 공급사 검색 실행 — 영속 분석 입력에서 만든 독립 계산 잡의 수명·옵션·오류를 추적한다.
// engineJobId가 소멸해도 같은 analysisRun으로 새 실행을 만들 수 있다.
model SpBomSupplierSearchRun {
  id                 BigInt           @id @default(autoincrement())
  quoteId            BigInt
  analysisRunId      BigInt
  engineJobId        String?          @db.VarChar(64)
  status             String           @db.VarChar(16) // preparing|running|completed|failed
  options            Json
  preflight          Json?
  resultSummary      Json?            @map("result_summary") // 실제 호출·캐시·시간·한도 소진 행의 compact 운영 지표
  catalogIngestRunId BigInt?
  error              String?          @db.VarChar(500)
  createdAt          DateTime         @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  quote              SpBomQuote       @relation("BomQuoteSupplierSearchRuns", fields: [quoteId], references: [id], onDelete: Cascade)
  activeForQuote     SpBomQuote?      @relation("BomQuoteActiveSupplierSearch")
  analysisRun        SpBomAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  catalogIngestRun   SpPartIngestRun? @relation(fields: [catalogIngestRunId], references: [id], onDelete: SetNull)
  resultArtifact     SpBomSupplierResultArtifact?
  searchTraces       SpBomSupplierSearchTrace[]

  @@index([quoteId, createdAt])
  @@index([analysisRunId, createdAt])
  @@index([catalogIngestRunId])
  @@index([status, createdAt])
  @@map("sp_bom_supplier_search_run")
}

// 공급사 검색 완료 원본을 압축 보존하는 영속 작업 원장. sp-engine 인메모리 잡이 사라져도
// DB·ES 저장과 견적 partId 연결을 동일 payload로 재개한다.
model SpBomSupplierResultArtifact {
  id                  BigInt                 @id @default(autoincrement())
  supplierSearchRunId BigInt                 @unique @map("supplier_search_run_id")
  payload             Bytes                  @db.LongBlob
  payloadChecksum     String                 @map("payload_checksum") @db.Char(64)
  payloadBytes        Int                    @map("payload_bytes")
  status              String                 @default("queued") @db.VarChar(16) // queued|running|completed|failed|dead
  attempts            Int                    @default(0)
  nextAttemptAt       DateTime?              @map("next_attempt_at")
  leaseUntil          DateTime?              @map("lease_until")
  lastErrorCode       String?                @map("last_error_code") @db.VarChar(64)
  lastError           String?                @map("last_error") @db.VarChar(500)
  completedAt         DateTime?              @map("completed_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  supplierSearchRun   SpBomSupplierSearchRun @relation(fields: [supplierSearchRunId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("sp_bom_supplier_result_artifact")
}

// 엔진이 실행 순간 확정한 실제 검색어·공급사 내부 fallback provenance.
// 검색 실행별 컴포넌트에 한 번만 저장하고 BOM 목록의 반복 폴링에서는 지연 조회한다.
model SpBomSupplierSearchTrace {
  id                  BigInt                 @id @default(autoincrement())
  supplierSearchRunId BigInt                 @map("supplier_search_run_id")
  engineComponentId   String                 @map("engine_component_id") @db.VarChar(24)
  rowIdx               Int                    @map("row_idx")
  traceVersion         String                 @map("trace_version") @db.VarChar(64)
  primaryQuery         String                 @map("primary_query") @db.VarChar(500)
  fallbackQuery        String?                @map("fallback_query") @db.VarChar(500)
  fallbackUsed         Boolean                @map("fallback_used")
  attemptCount         Int                    @map("attempt_count")
  payload              Json
  createdAt            DateTime               @default(now()) @map("created_at")
  supplierSearchRun    SpBomSupplierSearchRun @relation(fields: [supplierSearchRunId], references: [id], onDelete: Cascade, map: "fk_bom_supplier_trace_run")

  @@unique([supplierSearchRunId, engineComponentId], map: "uq_bom_supplier_trace_run_component")
  @@index([supplierSearchRunId, rowIdx], map: "idx_bom_supplier_trace_run_row")
  @@map("sp_bom_supplier_search_trace")
}

// 회원별 공급사 검색 일일 사용량 — 인메모리 카운터 대신 재시작·다중 인스턴스에도 유지한다.
model SpBomSupplierDailyUsage {
  id          BigInt   @id @default(autoincrement())
  mbId        String   @db.VarChar(60)
  dayKey      String   @db.Char(10) // Asia/Seoul YYYY-MM-DD
  searchCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mbId, dayKey])
  @@index([dayKey, searchCount])
  @@map("sp_bom_supplier_daily_usage")
}

// 분석 시트 원본 스냅샷 — 선택 여부는 견적 영역(sp_bom_quote_sheet)에 남기고 분석 자체는 불변이다.
model SpBomAnalysisSheet {
  id             BigInt                   @id @default(autoincrement())
  analysisRunId  BigInt
  sheetIndex     Int
  sheetName      String                   @db.VarChar(191)
  status         String                   @db.VarChar(16) // parsed|not_bom|error
  componentCount Int                      @default(0)
  columnCount    Int                      @default(0)
  failureReason  String?                  @db.VarChar(500)
  payload        Json
  createdAt      DateTime                 @default(now())
  analysisRun    SpBomAnalysisRun         @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  components     SpBomAnalysisComponent[]

  @@unique([analysisRunId, sheetIndex])
  @@index([analysisRunId, status])
  @@map("sp_bom_analysis_sheet")
}

// 엔진 ComponentRecord 원본 JSON을 payload에 그대로 박제한다. 자주 조인·표시하는 안정 필드만
// 열로 승격하며, 엔진이 새 필드를 추가해도 Node 표시 계층이 따라오기 전에 데이터부터 보존된다.
model SpBomAnalysisComponent {
  id                   BigInt             @id @default(autoincrement())
  analysisRunId        BigInt
  analysisSheetId      BigInt
  engineComponentId    String             @db.VarChar(24)
  sourceRows           Json
  referenceDesignators Json
  partNumber           String?            @db.VarChar(191)
  manufacturer         String?            @db.VarChar(191)
  componentType        String?            @db.VarChar(64)
  description          String?            @db.VarChar(1000)
  quantity             Int?
  packageCode          String?            @db.VarChar(191)
  reviewStatus         String             @db.VarChar(16)
  confidence           Float?
  searchText           String?            @db.Text
  payload              Json
  createdAt            DateTime           @default(now())
  analysisRun          SpBomAnalysisRun   @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  analysisSheet        SpBomAnalysisSheet @relation(fields: [analysisSheetId], references: [id], onDelete: Cascade)
  quoteItems           SpBomQuoteItem[]

  @@unique([analysisRunId, engineComponentId])
  @@index([analysisSheetId, id])
  @@index([analysisRunId, reviewStatus])
  @@map("sp_bom_analysis_component")
}

// 업로드 워크북 시트 분석·선택 스냅샷 — 선택 시트만 견적 계산·공급사 검색에 사용.
model SpBomQuoteSheet {
  id             BigInt     @id @default(autoincrement())
  quoteId        BigInt
  sheetIndex     Int
  sheetName      String     @db.VarChar(191)
  status         String     @db.VarChar(16) // parsed|not_bom|error
  componentCount Int        @default(0)
  selected       Boolean    @default(false)
  failureReason  String?    @db.VarChar(500)
  warnings       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  quote          SpBomQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, sheetIndex])
  @@index([quoteId, selected])
  @@map("sp_bom_quote_sheet")
}

// 견적 라인 — orderQty·selectedOffer 스냅샷이 단일 진실(요청 후 재선정 없음).
// partId 는 카탈로그(sp_part) 느슨한 참조(FK 없음 — 카탈로그 정리와 독립).
model SpBomQuoteItem {
  id                      BigInt                     @id @default(autoincrement())
  quoteId                 BigInt
  analysisComponentId     BigInt?                    @map("analysis_component_id")
  rowIdx                  Int
  included                Boolean                    @default(true)
  mpn                     String                     @db.VarChar(191)
  manufacturerName        String?                    @db.VarChar(191)
  description             String?                    @db.VarChar(1000)
  bomQty                  Int
  orderQty                Int                        @default(0)
  matchStatus             String                     @default("none") @db.VarChar(8) // auto|manual|none
  matchEvidence           Json? // 엔진 component 판정·후보·자동 선정 정책 스냅샷(BOM 문맥)
  searchRequirements      Json?                      @map("search_requirements")
  recommendedCandidateKey String?                    @db.VarChar(64) // 하이브리드 정책의 최초/현재 자동추천
  selectedCandidateKey    String?                    @db.VarChar(64) // 고객이 실제 선택한 견적 후보(카탈로그 직접선택은 null)
  selectionSource         String                     @default("none") @db.VarChar(16) // none|auto|customer|catalog|admin|legacy|partner
  partId                  BigInt?
  selectedOffer           Json?
  selectedRfqItemId       BigInt? // 협력사 회신 선정(selectionSource='partner') — 스냅샷은 selectedOffer 에 박제
  lineTotalKrw            Decimal?                   @db.Decimal(14, 2)
  sourceRow               Json?
  sourceSheetIndex        Int?
  sourceSheetName         String?                    @db.VarChar(191)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  quote                   SpBomQuote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  analysisComponent       SpBomAnalysisComponent?    @relation(fields: [analysisComponentId], references: [id], onDelete: SetNull)
  candidates              SpBomQuoteCandidate[]
  selectionEvents         SpBomQuoteSelectionEvent[]
  adminReviews            SpBomQuoteItemReview[]
  rfqItems                SpBomRfqItem[]             @relation("QuoteItemRfqItems")
  selectedRfqItem         SpBomRfqItem?              @relation("QuoteItemSelectedRfqItem", fields: [selectedRfqItemId], references: [id], onDelete: SetNull)

  @@unique([quoteId, rowIdx])
  @@index([quoteId, sourceSheetIndex])
  @@index([analysisComponentId])
  @@map("sp_bom_quote_item")
}

// 공급사 엔진 후보의 견적 문맥 스냅샷. 엔진 잡은 재시작 시 소멸하므로 고객 후보 비교가
// 인메모리 결과에 의존하지 않게 quoteId+rowIdx에 박제한다. payload는 엔진 스키마 변화를
// 흡수하고, 목록/정렬에 필요한 안정 필드만 열로 승격한다.
model SpBomQuoteCandidate {
  id               BigInt         @id @default(autoincrement())
  quoteId          BigInt
  quoteItemId      BigInt         @map("quote_item_id")
  candidateKey     String         @db.VarChar(64)
  technicalRank    Int
  status           String         @db.VarChar(32)
  selectionMode    String         @db.VarChar(24) // exact|variant|spec-compatible|review
  safety           String         @db.VarChar(12) // safe|caution|blocked
  autoEligible     Boolean        @default(false)
  mpn              String         @db.VarChar(191)
  manufacturerName String?        @db.VarChar(191)
  payload          Json
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quote            SpBomQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteItem        SpBomQuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@unique([quoteItemId, candidateKey])
  @@index([quoteId, technicalRank])
  @@index([quoteItemId, technicalRank])
  @@map("sp_bom_quote_candidate")
}

// 자동추천은 matchEvidence에 남기고, 고객/관리자의 명시 변경만 이벤트로 누적한다.
// 안정 quoteItemId로 연결하므로 표시 순서(rowIdx)가 바뀌어도 감사 대상이 유지된다.
model SpBomQuoteSelectionEvent {
  id                   BigInt         @id @default(autoincrement())
  quoteId              BigInt
  quoteItemId          BigInt         @map("quote_item_id")
  source               String         @db.VarChar(16) // customer|catalog|admin
  actorId              String?        @db.VarChar(60)
  previousCandidateKey String?        @db.VarChar(64)
  selectedCandidateKey String?        @db.VarChar(64)
  previousMpn          String?        @db.VarChar(191)
  selectedMpn          String?        @db.VarChar(191)
  previousOfferKey     String?        @db.VarChar(64)
  selectedOfferKey     String?        @db.VarChar(64)
  previousLineTotalKrw Decimal?       @db.Decimal(14, 2)
  selectedLineTotalKrw Decimal?       @db.Decimal(14, 2)
  reasonCodes          Json?
  createdAt            DateTime       @default(now())
  quote                SpBomQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteItem            SpBomQuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@index([quoteItemId, createdAt])
  @@index([quoteId, createdAt])
  @@map("sp_bom_quote_selection_event")
}

// 관리자 품목 검토 감사 이력. 현재 행의 판정·선정·수량이 바뀌면 fingerprint가 달라져
// 이전 확인은 자동으로 무효가 된다. 엔진의 기술 판정과 관리자 업무 확인을 섞지 않는다.
model SpBomQuoteItemReview {
  id          BigInt         @id @default(autoincrement())
  quoteId     BigInt
  quoteItemId BigInt         @map("quote_item_id")
  action      String         @db.VarChar(12) // confirmed|reopened
  fingerprint String         @db.Char(64)
  actorMbId   String         @map("actor_mb_id") @db.VarChar(60)
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at")
  quote       SpBomQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteItem   SpBomQuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@index([quoteItemId, createdAt], map: "idx_bom_quote_item_review_item_created")
  @@index([quoteId, createdAt], map: "idx_bom_quote_item_review_quote_created")
  @@map("sp_bom_quote_item_review")
}

// ── 공용 파트너 조직·스마트 BOM 협력사 RFQ (sp_partner*, sp_bom_rfq*) ───────
// 설계 정본: docs/SMARTBOM_PARTNER_RFQ.md. 레거시(g5_member 여분컬럼 협력사 + 가짜 회원
// 하드코딩 공급사)와 무관한 신규 모델 — 조직(sp_partner)/계정(sp_partner_member)/
// 자동화(supplierCode) 3축 분리. 코드 사전은 @sp/api-contract PARTNER_*·BOM_RFQ_* 정본.

// 협력사·공급사·자사의 조직 정본 — 견적/발주/물류 전 프로세스가 partnerId 하나만 참조.
// type: partner(사람 협력사)|supplier(API 공급사)|house(자사). 로그인 능력은 멤버 연결
// 존재로, 자동화 능력은 supplierCode 존재로 판정한다(하이브리드 = 둘 다).
model SpPartner {
  id              BigInt              @id @default(autoincrement())
  type            String              @db.VarChar(12) // partner|supplier|house
  name            String              @db.VarChar(191) // 회사명
  // supplier·house 만 보유 — SpPartOffer.supplier 와 같은 어휘(공급사 추가 = 행 추가, 코드 무배포)
  supplierCode    String?             @unique @db.VarChar(32)
  country         String?             @db.VarChar(2) // ISO alpha-2
  defaultCurrency String              @default("KRW") @db.VarChar(8)
  // 입력/표시 통화 — 결제통화(defaultCurrency)와 다를 때만 의미(위안화 입력 관행,
  // 레거시 mb_sub_currency 대응). PCB 트랙 P1(docs/PCB_PARTNER_TRACK.md D2).
  inputCurrency   String?             @db.VarChar(8)
  capabilities    Json // ["bom_rfq","pcb_rfq","part_sale"] — 레거시 partnerAuth 등급 재해석
  status          String              @default("pending") @db.VarChar(20) // pending|approved|suspended
  contactName     String?             @db.VarChar(100)
  contactPhone    String?             @db.VarChar(50)
  contactEmail    String?             @db.VarChar(255) // RFQ 알림 수신처
  businessNo      String?             @db.VarChar(30) // 견적서·거래명세서 발행자 사업자번호
  ownerName       String?             @db.VarChar(100)
  businessZip     String?             @db.VarChar(10)
  businessAddress String?             @db.VarChar(500)
  businessType    String?             @db.VarChar(100) // 업태
  businessItem    String?             @db.VarChar(100) // 종목
  fax             String?             @db.VarChar(50)
  memo            String?             @db.Text // 내부 메모 — 협력사 비노출
  statusReason    String?             @db.VarChar(255) // 정지/반려 사유(SpMarketExpert 관례)
  decidedBy       String?             @db.VarChar(191) // 처리 관리자 mbId
  decidedAt       DateTime?
  legacyJson      Json? // partnerAuth 승격 이관 원본 보존(SpMemberProfile 관례)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         SpPartnerMember[]
  rfqs            SpBomRfq[]
  pos             SpBomPo[]
  pcbRfqs         SpPcbRfq[]
  pcbPos          SpPcbPo[]
  pcbAsCases      SpPcbAsCase[] // 재생산 대상(target)으로서
  childRelations  SpPartnerRelation[] @relation("PartnerRelationParent")
  parentRelations SpPartnerRelation[] @relation("PartnerRelationChild")

  @@index([type, status]) // 관리자 목록 탭×유형 필터
  @@map("sp_partner")
}

// 계정 연결 — 로그인 가능 주체(정상 가입한 g5_member 를 조직에 연결, 가짜 회원 없음).
// 공급사는 연결 0명이 자연 표현. mbId 는 JWT 클레임 유래 문자열 — FK 금지(공유 DB 조인 키).
// 스키마는 1:N(role), 1차 운영은 owner 1행.
model SpPartnerMember {
  id        BigInt    @id @default(autoincrement())
  partnerId BigInt
  mbId      String    @db.VarChar(191) // mb_id 계열(이메일 아이디 수용)
  role      String    @default("owner") @db.VarChar(12) // owner|staff
  createdAt DateTime  @default(now())
  partner   SpPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, mbId])
  @@index([mbId]) // requirePartner 매 요청 판정(mbId → 소속 조직)
  @@map("sp_partner_member")
}

// 마스터딜러 2단 중개 링크 — 스키마만 선반영(D4), 구현은 후속. settlementCurrency 는
// 레거시 최종형(링크별 결제통화 KRW/USD/CNY)의 자리.
model SpPartnerRelation {
  id                 BigInt    @id @default(autoincrement())
  parentPartnerId    BigInt
  childPartnerId     BigInt
  settlementCurrency String?   @db.VarChar(8)
  createdAt          DateTime  @default(now())
  parent             SpPartner @relation("PartnerRelationParent", fields: [parentPartnerId], references: [id], onDelete: Cascade)
  child              SpPartner @relation("PartnerRelationChild", fields: [childPartnerId], references: [id], onDelete: Cascade)

  @@unique([parentPartnerId, childPartnerId])
  @@map("sp_partner_relation")
}

// 협력사 견적요청(RFQ) 문서 — (quote × 협력사 × 중개 경로) 1건. diff 발송으로 갱신하며
// 재발송 시 유지분은 보존한다. **사람 협력사 전용** — 공급사 시세는 후보/구매 조건 원장 파생(D6),
// RFQ 행으로 물질화하지 않는다.
model SpBomRfq {
  id              BigInt         @id @default(autoincrement())
  quoteId         BigInt
  partnerId       BigInt
  parentPartnerId BigInt         @default(0) // 0=관리자 직접(센티넬 — FK 없음). MD 중개는 후속
  status          String         @default("requested") @db.VarChar(16) // requested|quoted|closed
  totalAmount     Int? // 회신 합계(KRW 정수) — 회신 저장 시 박제
  currency        String         @default("KRW") @db.VarChar(8) // 1차 KRW 단일(D7) — 외화 회신 자리
  deliveryDate    DateTime? // 협력사 회신 납기
  memo            String?        @db.Text // 협력사 회신 메모
  requestedAt     DateTime       @default(now()) // 최근 발송 시각(diff 재발송 시 갱신)
  respondedAt     DateTime?
  // 매직링크 무로그인 회신(§6.9) — 랜덤 64hex, 재발급 시 회전(구 토큰 즉시 무효).
  // 무효 조건: 불일치 · RFQ closed(PUT만) · 발급 30일 경과(magicTokenAt 기준).
  magicToken      String?        @unique @db.VarChar(64)
  magicTokenAt    DateTime?
  // 부분 행 선택(§6.13, 레거시 승계) — 요청 부품행 id 문자열 배열. null=전체(기존
  // RFQ 하위호환). 표시·검증 범위 = scope 파생 ∩ 이 집합(행 삭제 자연 방어).
  requestedItemIds Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  quote           SpBomQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  partner         SpPartner      @relation(fields: [partnerId], references: [id])
  items           SpBomRfqItem[]

  @@unique([quoteId, partnerId, parentPartnerId])
  @@index([partnerId, status]) // 협력사 포털 워크큐
  @@map("sp_bom_rfq")
}

// 협력사 발주서(D18) — Case × 협력사 1건. **박제 문서**(생성 시점 스냅샷, 이후 견적
// 변경과 무관·불변 — snapshot-freeze). 결제 확인(od isPaid) 후에만 발행하며,
// issued(미확인)만 삭제 가능. 선적 참조는 두지 않는다(D13 선행 제약 준수).
model SpBomPo {
  id          BigInt         @id @default(autoincrement())
  quoteId     BigInt
  partnerId   BigInt
  status      String         @default("issued") @db.VarChar(16) // issued|confirmed|closed
  totalAmount Int // 발주 합계(KRW 정수, VAT 별도) — 생성 시 박제
  currency    String         @default("KRW") @db.VarChar(8)
  memo        String?        @db.Text // 관리자 발주 메모(협력사 노출)
  // 외부공급사 실행 결과 박제(D20) — Mouser {cartKey…}/DigiKey {singleUseUrl…}/실패 {error}.
  // 사람 협력사 발주는 null. 재시도 시 덮어쓴다.
  externalRef Json?
  // 협력사 견적서 발행 시점 스냅샷. 기존 PO는 최초 조회 시 불변 발주 데이터로 보강한다.
  quotationData Json?
  quotationDeliveryDate DateTime?
  quotationMemo String? @db.Text
  issuedAt    DateTime       @default(now())
  confirmedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  quote       SpBomQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  partner     SpPartner      @relation(fields: [partnerId], references: [id])
  items       SpBomPoItem[]
  shipment    SpBomShipment? // 대표(생성) 관계 — 소속 판정은 shipmentLink 가 진실(§6.10)
  shipmentLink SpBomShipmentPo?

  @@unique([quoteId, partnerId])
  @@index([partnerId, status]) // 협력사 포털 워크큐
  @@map("sp_bom_po")
}

// 선적(D21) — 경량 모델: 1차는 발주서당 1건(poId UNIQUE). 발주 스키마 무참조(D13)라
// 부분 입고(UNIQUE 해제+행 배정)·선적 그룹(groupId 추가)으로 발주서 무변경 확장 가능.
// mode 는 생성 시 박제(레거시 관례): international=6단계, domestic=3단계 — 코드 사전
// @sp/api-contract BOM_SHIPMENT_* 정본. 입고 확인(검수 ⑩)=receivedAt+편차 메모.
model SpBomShipment {
  id             BigInt    @id @default(autoincrement())
  // §6.10 그룹 도입 후 poId = 생성(대표) 발주서, quoteId = 대표의 Case. 소속의 진실은
  // 조인(SpBomShipmentPo) — 파생 집계는 조인 기반으로 계산한다(다중 Case 묶음 가능).
  poId           BigInt    @unique
  quoteId            BigInt
  mode           String    @default("international") @db.VarChar(16) // international|domestic
  status         String    @db.VarChar(20) // 모드별 코드 사전(intl 6단계/domestic 3단계)
  // 운송수단(2026-08-16) — air|sea, **국제 전용**(mode 와 직교: 국경/운반수단). null 은
  // 미선택(이 축 도입 전 데이터·국내)이며 읽는 쪽이 'air' 로 접는다. PCB 트랙과 같은
  // 공용 사전(SHIPMENT_TRANSPORTS)을 쓰고, 운송서류가 이 값에서 갈린다(AWB/BL).
  transport      String?   @db.VarChar(8)
  carrier        String?   @db.VarChar(50)
  trackingNumber String?   @db.VarChar(100)
  trackingUrl    String?   @db.VarChar(500)
  shipDate           DateTime? // 출고예정일 — 협력사 '선적 요청' 진입 시 입력(D22)
  // 샘플피씨비 운송(Case ID) 갈래 — 협력사가 요청하면 관리자가 부킹·운송서류·
  // 운송장을 준비한다. 상태 사전은 PCB와 마찬가지로 그대로 두고 문서 차례만 기록한다.
  caseRefRequestedAt DateTime?
  caseRefNote        String?   @db.VarChar(255)
  caseRef            String?   @db.VarChar(100)
  caseRefFilledAt    DateTime?
  shippedAt          DateTime? // 발송(shipped/shipping 진입) 시점 박제
  receivedAt         DateTime? // 입고 확인(검수) — 타임라인 ⑩ 파생 근거
  receivedNote   String?   @db.Text // 편차 메모(수량 부족·불량 등)
  completedAt        DateTime? // 최종 단계(done/delivered) 진입 시점 박제
  invoiceData        Json? // 상업송장 편집본(D23) — 생성기 프리필용, 레거시 invoice_data 미러
  packingRevision    Int                 @default(0) // 선적 리스트 저장 리비전(재인쇄는 증가시키지 않음)
  packingUpdatedAt   DateTime? // 마지막 선적 리스트 저장 시각
  packingFinalizedAt DateTime? // preparing 이탈 시 현재 리비전 확정, 되돌리면 해제
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  po             SpBomPo   @relation(fields: [poId], references: [id], onDelete: Cascade)
  pos                SpBomShipmentPo[]
  packingItems       SpBomShipmentItem[]

  @@index([quoteId])
  @@map("sp_bom_shipment")
}

// 선적 그룹(§6.10) — 선적:발주서 = 1:N 소속의 진실. poId UNIQUE = 발주서는 최대
// 1개 선적 소속(부분 입고 확장 전까지). 발주서 스키마에 선적 참조를 넣지 않는
// D13 원칙은 조인 테이블이라 유지된다.
model SpBomShipmentPo {
  id         BigInt        @id @default(autoincrement())
  shipmentId BigInt
  poId       BigInt        @unique
  createdAt  DateTime      @default(now())
  shipment   SpBomShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  po         SpBomPo       @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("sp_bom_shipment_po")
}

// 발주 행 — 생성 시점의 부품·수량·단가 스냅샷(견적 행이 이후 바뀌어도 불변).
// quoteItemId·rfqItemId 는 근거 추적용 참조(FK 없음 — 박제 문서의 독립성 유지).
model SpBomPoItem {
  id               BigInt              @id @default(autoincrement())
  poId             BigInt
  quoteItemId      BigInt // 근거 견적 행(참조만)
  rfqItemId        BigInt? // 근거 회신 행(참조만)
  mpn              String              @db.VarChar(191)
  manufacturerName String?             @db.VarChar(191)
  description      String?             @db.VarChar(1000)
  supplierSku      String?             @db.VarChar(191) // 공급사 발주(D20) 실행용 SKU 박제 — 협력사 발주는 null
  qty              Int // 발주 수량(= 생성 시점 orderQty 박제)
  unitPrice        Decimal             @db.Decimal(14, 4) // 선정 단가 박제(VAT 별도)
  lineTotal        Int // round(unitPrice × qty) KRW 정수
  moq              Int?
  stock            Int?
  dateCode         String?             @db.VarChar(100)
  leadTime         String?             @db.VarChar(64)
  quotationMemo    String?             @db.VarChar(500)
  createdAt        DateTime            @default(now())
  po               SpBomPo             @relation(fields: [poId], references: [id], onDelete: Cascade)
  shipmentItems    SpBomShipmentItem[]
  shortage         SpBomPoShortage?     @relation("BomPoShortageSource")
  recoverySource   SpBomPoShortage?     @relation("BomPoShortageRecovery")
  receivingScans   SpBomReceivingScan[] // 입고 스캔 원장(D42)

  @@index([poId])
  @@map("sp_bom_po_item")
}

// ── 입고 스캔 원장(D42, docs/SMARTBOM_PARTNER_RFQ.md §6.35) ──────────────────────────────
// 공급사 봉투 라벨(ECIA 2D) 스캔 1건 = 1행. 매칭된 발주 품목이 없어도 남긴다(미매칭 추적).
// 패킹 리스트(D24)는 전량 합계 일치가 저장 조건이라 부분 입고를 담을 수 없어 별도 원장으로 둔다.
model SpBomReceivingScan {
  id              BigInt       @id @default(autoincrement())
  poItemId        BigInt? // 매칭된 발주 품목(삭제되면 null 로 남김)
  poId            BigInt? // 조회 편의(매칭 시점 박제)
  supplierCode    String?      @db.VarChar(32) // 라벨로 판정한 공급사(digikey|mouser) — 미판정 null
  barcode         String       @db.Text // 정규화 원문(제어문자 포함)
  supplierSku     String?      @db.VarChar(191) // 라벨 P/30P
  mpn             String?      @db.VarChar(191) // 라벨 1P
  quantity        Int // 입고 수량(라벨 Q, 수기 정정 가능)
  lotCode         String?      @db.VarChar(100)
  dateCode        String?      @db.VarChar(100)
  countryOfOrigin String?      @db.VarChar(16)
  supplierOrderNo String?      @db.VarChar(64)
  customerOrderNo String?      @db.VarChar(64)
  invoiceNo       String?      @db.VarChar(64)
  note            String?      @db.VarChar(500)
  scannedBy       String       @db.VarChar(64) // 관리자 mb_id
  scannedAt       DateTime     @default(now())
  voidedAt        DateTime? // 잘못 찍은 건 취소(삭제 아님)
  poItem          SpBomPoItem? @relation(fields: [poItemId], references: [id], onDelete: SetNull)

  @@index([poItemId])
  @@index([poId])
  @@index([scannedAt])
  @@map("sp_bom_receiving_scan")
}

// 조달 차질·잔량 대체발주(D31) — 원 PO 품목의 수량·금액은 불변으로 두고, 협력사가
// 공급하지 못하는 수량과 사유를 별도 감사 원장으로 남긴다. recoveryPoItemId 는 부족분을
// 이어받은 새 PO 품목이며 삭제되면 다시 미복구 상태가 되도록 SetNull 한다.
model SpBomPoShortage {
  id               BigInt       @id @default(autoincrement())
  sourcePoItemId   BigInt       @unique
  shortageQty      Int
  reason           String       @db.VarChar(32)
  note             String?      @db.Text
  reportedByMbId   String?      @db.VarChar(191)
  reportedAt       DateTime     @default(now())
  recoveryPoItemId BigInt?      @unique
  recoveredAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sourceItem       SpBomPoItem  @relation("BomPoShortageSource", fields: [sourcePoItemId], references: [id], onDelete: Cascade)
  recoveryItem     SpBomPoItem? @relation("BomPoShortageRecovery", fields: [recoveryPoItemId], references: [id], onDelete: SetNull)

  @@index([recoveryPoItemId])
  @@map("sp_bom_po_shortage")
}

// 선적 리스트 품목 — 발주 품목의 물류 투영. 발주 품목은 박제 원본이고 이 행은 선적별
// 포장(QR)을 묶는 안정 ID다. partId 는 견적의 카탈로그 연결을 복사한 느슨한 참조이며
// 카탈로그 정리와 독립시키기 위해 FK를 두지 않는다.
model SpBomShipmentItem {
  id          BigInt             @id @default(autoincrement())
  shipmentId  BigInt
  poItemId    BigInt
  partId      BigInt?
  expectedQty Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  shipment    SpBomShipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  poItem      SpBomPoItem        @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  packages    SpBomPartPackage[]

  @@unique([shipmentId, poItemId])
  @@index([poItemId])
  @@index([partId])
  @@map("sp_bom_shipment_item")
}

// 실물 관리 단위 — 릴·트레이·튜브·봉투·박스 1개마다 QR 1개. token 은 스캔 URL에만
// 쓰는 256-bit 불투명 식별자이며 labelCode 는 QR 손상 시 수기 조회용이다.
model SpBomPartPackage {
  id              BigInt            @id @default(autoincrement())
  shipmentItemId  BigInt
  token           String            @unique @db.Char(64)
  labelCode       String            @unique @db.VarChar(24)
  packageNo       Int
  quantity        Int
  lotNo           String?           @db.VarChar(100)
  dateCode        String?           @db.VarChar(100)
  status          String            @default("prepared") @db.VarChar(16) // prepared|received|inspected|stored|issued|voided
  storageLocation String?           @db.VarChar(191)
  receivedAt      DateTime?
  inspectedAt     DateTime?
  issuedAt        DateTime?
  voidedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  shipmentItem    SpBomShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  events          SpBomPartEvent[]

  @@index([shipmentItemId, status])
  @@index([status, updatedAt])
  @@map("sp_bom_part_package")
}

// QR 포장 추적 원장 — 현재 상태와 별개로 생성·인쇄·입고·검수·보관·출고·무효 이력을
// append-only로 남긴다. QR은 식별자일 뿐 권한이 아니므로 모든 기록은 인증된 actor를 박제.
model SpBomPartEvent {
  id         BigInt           @id @default(autoincrement())
  packageId  BigInt
  eventType  String           @db.VarChar(16) // created|updated|printed|received|inspected|stored|issued|voided
  actorType  String           @db.VarChar(16) // ADMIN|PARTNER|SYSTEM
  actorMbId  String?          @db.VarChar(191)
  fromStatus String?          @db.VarChar(16)
  toStatus   String?          @db.VarChar(16)
  quantity   Int?
  location   String?          @db.VarChar(191)
  note       String?          @db.Text
  occurredAt DateTime         @default(now())
  package    SpBomPartPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, occurredAt])
  @@map("sp_bom_part_event")
}

// 협력사 회신 행 — 부품행(quoteItemId) 단위, 안정 ID 연결(rowIdx 아님).
// source: manual(포털 회신/관리자 대리 입력 — 자동 동기화 불가침)|api(하이브리드 대비 예약).
model SpBomRfqItem {
  id          BigInt           @id @default(autoincrement())
  rfqId       BigInt
  quoteItemId BigInt           @map("quote_item_id")
  source      String           @default("manual") @db.VarChar(8) // manual|api
  unitPrice   Decimal?         @db.Decimal(14, 4)
  currency    String           @default("KRW") @db.VarChar(8)
  replyQty    Int? // 회신 수량(요청수량과 다르게 회신 가능)
  moq         Int?
  stock       Int?
  dateCode    String?          @db.VarChar(100)
  leadTime    String?          @db.VarChar(64)
  memo        String?          @db.VarChar(500)
  offerId     BigInt? // source=api 근거 SpPartOffer 참조 — 카탈로그 정리와 분리(FK 없음)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rfq         SpBomRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteItem   SpBomQuoteItem   @relation("QuoteItemRfqItems", fields: [quoteItemId], references: [id], onDelete: Cascade)
  selectedFor SpBomQuoteItem[] @relation("QuoteItemSelectedRfqItem")

  @@unique([rfqId, quoteItemId])
  @@index([quoteItemId]) // 행별 비교 조회
  @@map("sp_bom_rfq_item")
}

// ── 빠른 메일(§6.15) — 관리자 수동 메일: 템플릿 + 발송 이력 ───────────────────
// 자동 알림(전이 트리거)과 별개로 Case 맥락에서 자유 작성해 보내는 CS 메일.
// 템플릿 변수({고객명} 등) 치환은 클라이언트가 하고 서버는 받은 그대로 발송한다.
model SpMailTemplate {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sp_mail_template")
}

// 발송 이력 — 전 채널(email·alimtalk·sms) 공용 발송 원장(감사·CS 기록). ref* 는 FK 없는
// 참조(원본 삭제 후에도 로그 보존). sp_delete_audit 의 subjectType/subjectId 와 같은 일반화
// 인데, 이 테이블은 메일 제목 컬럼(subject)과의 충돌을 피해 refType/refId 로 명명한다.
// 본문 정책(비대 방지): 수동 메일(quick_mail)만 body 원문 보존, 자동 알림은 빌더 파라미터
// 요약(params)만 남긴다 — 빌더가 순수 함수라 재현 가능. 첨부 실파일은 보관하지 않는다
// (메일로만 전달) — 메타([{name,size,mime}])만 남긴다.
model SpMailLog {
  id          BigInt   @id @default(autoincrement())
  kind        String   @db.VarChar(32) // 발송 종류 코드: quick_mail|estimate|bom_rfq_request|pcb_po_issued|order_notify…
  refType     String   @db.VarChar(24) // 컨텍스트: bom_quote|pcb_spec|order|market_project|market_contract…
  refId       String   @db.VarChar(64)
  channel     String   @db.VarChar(12) // email|alimtalk|sms
  status      String   @db.VarChar(12) // sent|failed|skipped
  reason      String?  @db.VarChar(255) // failed·skipped 사유 코드(send_failed|mail_unavailable|missing_recipient…)
  recipient   String   @db.VarChar(255) // 이메일 또는 전화번호. ''=발송 주체가 수신처를 모름(PHP 브리지)
  toMbId      String?  @db.VarChar(191)
  subject     String   @db.VarChar(255) // 채널에 제목이 없으면(sms 등) ''
  body        String?  @db.Text // quick_mail 원문만 — 자동 알림은 null
  params      Json? // 자동 알림 빌더 파라미터 요약(표시·재현용)
  attachments Json?
  sentBy      String?  @db.VarChar(191) // 트리거 주체 mbId(관리자·파트너) — null=시스템(매직링크·자동)
  createdAt   DateTime @default(now())

  @@index([refType, refId, createdAt])
  @@index([createdAt])
  @@map("sp_mail_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// PCB 파트너 트랙 (docs/PCB_PARTNER_TRACK.md) — 레거시 SmartBOM PCB 트랙 이식.
// 앵커 = sp_order_spec(§3 개념 매핑, g5 상품 it_id 아님). P1=RFQ, P2=발주·EQ,
// P3=선적, P4=A/S. MD 2단 중개·통화 3종은 1차 포함(§6 D1·D2, 2026-08-04 확정).
// ═══════════════════════════════════════════════════════════════════════════

// PCB 협력사 견적행 — (spec × 협력사 × 중개 트랙 × 회차) 1건. BOM RFQ 와 달리 부품행
// 계층이 없는 단일가 문서(레거시 sp_pcb_partner_order 대응). RFQ 시작 조건 = 담기지
// 않은 active 스펙(§5.2-1 — 확정가 등록의 IN_CART/ORDERED 409 가드와 짝).
model SpPcbRfq {
  id              BigInt      @id @default(autoincrement())
  specId          BigInt // sp_order_spec.id — 스펙 삭제 시 RFQ 도 소멸(레거시 cascade 승계)
  partnerId       BigInt
  parentPartnerId BigInt      @default(0) // 0=관리자 직접(센티넬 — FK 없음), 그 외=MD partnerId
  reorderRound    Int         @default(0) // 0=원견적, 1..=A/S 회차(P4)
  status          String      @default("requested") @db.VarChar(16) // requested|quoted|selected|unselected
  // 금액 정본 = 결제통화(priceOriginal, 링크별 KRW|USD|CNY — D2). krwAmount 는 선정 시
  // 환산 박제(외화 선정 전 null — 표시는 main(통화,원본,KRW)+sub 3값 로직, §7-5).
  currency        String      @default("KRW") @db.VarChar(8)
  priceOriginal   Decimal?    @db.Decimal(15, 2)
  exchangeRate    Decimal?    @db.Decimal(12, 6) // 선정 시 결제통화→KRW 박제(KRW 면 null)
  krwAmount       Int?
  // 입력통화 레이어 — 입력≠결제일 때만 3종 박제(위안화 입력 관행), 같으면 명시적 null 클리어.
  subCurrency      String?    @db.VarChar(8)
  subPriceOriginal Decimal?   @db.Decimal(15, 2)
  subExchangeRate  Decimal?   @db.Decimal(12, 6)
  // MD 변환점 박제(D1) — priceOriginal = sourceAmount × sourceRate × (1+marginRate/100),
  // 중간 반올림 없이 최종 1회 HALF_UP(KRW 0자리·외화 2자리). 하위 견적가가 나중에 바뀌어도
  // 이 행의 회신가는 불변(감사 복원 근거 — 레거시 source_* 승계).
  selectedChildRfqId BigInt? // MD 가 선정한 하위 견적행 id(자기참조 — FK 없음)
  marginRate      Int?
  sourceCurrency  String?     @db.VarChar(8)
  sourceAmount    Decimal?    @db.Decimal(15, 2)
  sourceRate      Decimal?    @db.Decimal(12, 6)
  // 납기 신호 — 제시(관리자/MD, 하향 상속 prefill) vs 회신(협력사 필수). 불일치='변경됨' 배지.
  suggestedDeliveryDate DateTime?
  quotedDeliveryDate    DateTime?
  memo            String?     @db.Text // 협력사 회신 메모
  requestedAt     DateTime    @default(now()) // 최근 발송 시각(diff 재발송 시 갱신)
  respondedAt     DateTime?
  selectedAt      DateTime?
  // 매직링크 무로그인 회신 — BOM §6.9 동형(64hex 회전, 발급 30일 경과 무효).
  magicToken      String?     @unique @db.VarChar(64)
  magicTokenAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  spec            SpOrderSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  partner         SpPartner   @relation(fields: [partnerId], references: [id])

  @@unique([specId, partnerId, parentPartnerId, reorderRound])
  @@index([partnerId, status]) // 협력사 포털 워크큐
  @@index([specId])
  @@map("sp_pcb_rfq")
}

// PCB 협력사 발주서(P2) — (spec × 협력사 × 중개 트랙 × 회차) 1건, 레거시
// sp_pcb_partner_order_document 대응. **박제 문서**: 발주가는 생성 시점 스냅샷
// (선정 견적행 프리필 후 수정 가능, 이후 견적 변경과 무관). status 가 EQ·생산
// 5단계 진행 머신을 겸한다(별도 컬럼 없음 — 레거시 재해석 승계, 서버가 순서·주체 검증).
// paid 게이트: 고객 주문 결제 확인(od isPaid) 후에만 발행(§5.2-2, BOM D18 동형).
model SpPcbPo {
  id              BigInt      @id @default(autoincrement())
  specId          BigInt
  partnerId       BigInt // 수주 조직
  parentPartnerId BigInt      @default(0) // 0=관리자 발주(센티넬), 그 외=MD 조직 id(하위 재발주)
  reorderRound    Int         @default(0) // 0=원발주, 1..=A/S 회차(P4)
  rfqId           BigInt? // 근거 견적행(FK 없음 — 직접 발주는 null)
  fulfillmentMode String      @default("self") @db.VarChar(16) // self=수주 조직 직접 제작, delegated=하위 발주 위임(발주 시점 박제)
  status          String      @default("issued") @db.VarChar(16) // issued|eq_requested|eq_done|producing|produced
  // 발주가 — RFQ 와 같은 통화 체계(결제통화 정본 + KRW 회계 보조 + 입력 원본 3종).
  // krwAmount 는 관리자 직접 발주 외화 건의 회계 박제(MD→하위 발주는 null — 레거시 승계).
  currency        String      @default("KRW") @db.VarChar(8)
  priceOriginal   Decimal     @db.Decimal(15, 2)
  exchangeRate    Decimal?    @db.Decimal(12, 6)
  krwAmount       Int?
  subCurrency      String?    @db.VarChar(8)
  subPriceOriginal Decimal?   @db.Decimal(15, 2)
  subExchangeRate  Decimal?   @db.Decimal(12, 6)
  // 배송 목적지(KR/CN/VN) — 직송 스위치는 P3 범위, 컬럼만 선반영(D5).
  destinationCountry String?  @db.VarChar(2)
  paymentTerms    String?     @db.VarChar(50) // 'T/T in Advance' 등
  // 발주 단계의 송금 예정일. 실제 송금일은 sp_pcb_remittance.remittedOn 이 정본이며,
  // 이 값은 지급 일정·지연 표시만 담당한다.
  remittanceDueOn DateTime?
  // ⚠ 송금의 정본은 sp_pcb_remittance(원장)다. 이 컬럼은 **파생 캐시** — 마지막 송금일을
  // 서버가 원장 변경마다 다시 계산해 넣는다(목록·협력사 포털의 기존 표시가 쓰는 값).
  // 직접 쓰지 말 것: 원장을 거치지 않으면 금액·잔액과 어긋난다.
  remittedAt      DateTime?
  deliveryDate    DateTime? // 발주 납기
  // EQ·생산 전이 이력 — [{at, byRole, fromStatus, toStatus, note}] 누적(정본은 하위
  // 발주서 — MD 경유 상위는 상태만 미러). 첨부는 sp_file(refType 'sp_pcb_po_eq').
  eqHistory       Json?
  memo            String?     @db.Text
  issuedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  spec            SpOrderSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  partner         SpPartner   @relation(fields: [partnerId], references: [id])
  remittances     SpPcbRemittance[]
  eqReviews       SpPcbEqReview[]
  packages        SpPcbPackage[]

  @@unique([specId, partnerId, parentPartnerId, reorderRound])
  @@index([partnerId, status]) // 협력사 포털 워크큐
  @@index([deliveryDate]) // 관리자 발주·EQ 납기 범위 필터
  @@index([specId])
  @@map("sp_pcb_po")
}

// PCB EQ 고객 확인 원장(P4.1) — 발주서 1:N 확인 요청. docs/PCB_PARTNER_TRACK.md D16.
// EQ 는 반려 → 보완 → 재요청이 반복되므로 발주서에 컬럼 한 칸(customerApprovedAt)이
// 아니라 회차별 원장이다(송금 원장과 같은 판단).
//
// ⚠ 이것은 EQ 전이 머신(PCB_EQ_FORWARD)의 **옆에 붙는 별도 축**이다. 고객이 승인해도
// 상태는 eq_requested 그대로이고, eq_done 전이는 여전히 관리자(ORDERER) 몫이다.
// 고객 확인은 관리자 승인의 '근거'를 남기는 것이지 승인 권한의 이양이 아니다(사용자 결정).
model SpPcbEqReview {
  id            BigInt    @id @default(autoincrement())
  poId          BigInt
  /** 조회 키 비정규화 — 고객 화면은 주문→cart→spec 으로 찾아 들어온다(발주서를 모른다).
   *  발주서의 specId 는 불변이라 어긋날 여지가 없다. */
  specId        BigInt
  status        String    @default("requested") @db.VarChar(16) // requested|approved|rejected|canceled
  /** 관리자가 쓴 확인 문구 — 협력사 EQ 원문을 그대로 넘기지 않는다(맥락이 다르다). */
  message       String    @db.Text
  dueOn         DateTime? // 회신 기한(KST 날짜 앵커)
  /** 고객에게 공개한 EQ 첨부 id 목록(sp_file.id). 협력사 정보가 든 파일을 거르기 위해
   *  관리자가 **고른 것만** 담는다 — 다운로드도 이 목록으로 검증한다(사용자 결정). */
  sharedFileIds Json
  requestedBy   String    @db.VarChar(191)
  requestedAt   DateTime  @default(now())
  decidedBy     String?   @db.VarChar(191) // 고객 mb_id
  decidedAt     DateTime?
  decisionNote  String?   @db.Text // 반려 사유·의견
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  po            SpPcbPo   @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([specId, status])
  @@map("sp_pcb_eq_review")
}

// PCB 송금 원장 — 발주서 1:N 송금. **부분·분할 송금이 실재**하기 때문에 상태 한 칸이
// 아니라 원장이다(결제조건 '50% PRE-PAID' 를 고를 수 있는데 송금은 한 줄만 받던 모순).
// 미지급 잔액 = 발주가 − 이 원장의 합계이며, 그 계산이 송금 관리의 핵심 지표다.
//
// 공용(sp_remittance + subjectType)으로 가지 않은 이유: 송금은 **살아있는 발주서**에
// 붙어 잔액을 계산하므로 FK 무결성이 필요하다. sp_delete_audit 이 FK 없이 subjectType
// 규약을 쓴 건 대상이 이미 삭제된 뒤를 가리키기 때문이고, 성격이 다르다(2026-08-06).
// 증빙(이체증)은 sp_file refType 'sp_pcb_remittance' 규약을 쓴다.
model SpPcbRemittance {
  id           BigInt   @id @default(autoincrement())
  poId         BigInt
  /** 송금일(KST 날짜) — parseKstDate 앵커. 시각은 의미 없다(§7-8). */
  remittedOn   DateTime
  /** 송금 통화 = 발주 통화(서버 검증). 잔액을 같은 통화로만 빼기 위해. */
  currency     String   @db.VarChar(8)
  amount       Decimal  @db.Decimal(15, 2)
  /** 외화 송금의 **실제 적용 환율** — 발주 시점 환율과 다르다(환차손익 근거). KRW 면 null. */
  exchangeRate Decimal? @db.Decimal(12, 6)
  krwAmount    Int? // 회계 환산 박제(외화만)
  memo         String?  @db.VarChar(500)
  createdBy    String   @db.VarChar(191) // 기록자 mbId — 돈 기록이라 행위자를 남긴다
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  po           SpPcbPo  @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([remittedOn])
  @@map("sp_pcb_remittance")
}

// PCB A/S 케이스(P4) — 완료·출고된 발주의 재생산(회차 재발주) 접수 헤더. 정본
// docs/PCB_PARTNER_TRACK.md §9 A/S. 레거시 sp_pcb_as_case 승계: 얇은 헤더로
// 접수·회신만 돌고, **[재발주 진행] 시점에 회차(reorderRound)를 부여**하면서
// 회차 발주서를 만든다(미전송 초안이 회차를 점유하지 않게 null 시작 — UK 는
// 진행된 건만 회차 유일). 발주서 상태와 독립 — 케이스는 합의 기록, 생산은
// 회차 발주서(sp_pcb_po reorderRound>0)가 기존 EQ·선적 파이프를 그대로 탄다.
// 첨부는 sp_file refType 'sp_pcb_as_case'(uploadedBy 로 관리자/협력사 구분 —
// 레거시는 회신 첨부가 관리자 첨부를 통째로 덮어쓰는 결함, 여기서 교정).
model SpPcbAsCase {
  id              BigInt      @id @default(autoincrement())
  specId          BigInt
  /** proceed 시 채번(같은 스펙 케이스 MAX+1, 1부터). null=미진행. */
  reorderRound    Int?
  caseType        String      @db.VarChar(16) // admin_fault|product_defect
  /** 기본 규칙: admin_fault=paid / product_defect=free(관리자 변경 가능). 협력사
   *  회신(수락/거절)이 곧 이 조건의 승인/반려다. 금액 컬럼은 두지 않는다 — 유상
   *  금액은 회차 발주서의 발주 조건 수정(P3.10)으로 다룬다(레거시 동형). */
  chargeType      String      @db.VarChar(8) // paid|free
  description     String?     @db.Text // 관리자 접수 사유(불량 내용·잘못 보낸 정보)
  status          String      @default("draft") @db.VarChar(16) // draft|submitted|accepted|rejected|proceeded
  /** 재생산 협력사(회신 주체). 트랙은 이 협력사의 원주문(round 0) 발주에서 도출. */
  targetPartnerId BigInt
  parentPartnerId BigInt      @default(0) // 0=직거래, 그 외=MD 조직 id
  replyReason     String?     @db.Text // 협력사 회신 사유(거절 시 권장)
  createdBy       String      @db.VarChar(191) // 접수 관리자 mbId
  submittedAt     DateTime?
  repliedAt       DateTime?
  proceededAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  spec            SpOrderSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  targetPartner   SpPartner   @relation(fields: [targetPartnerId], references: [id])

  @@unique([specId, reorderRound])
  @@index([targetPartnerId, status]) // 협력사 포털 회신 대기
  @@index([parentPartnerId]) // MD 열람 격리
  @@map("sp_pcb_as_case")
}

// PCB 고객 클레임(A/S 접수, P5) — BOM 클레임(sp_bom_claim, D37)의 PCB 미러.
// 고객↔자사 축의 접수·검토·판정 원장이다. 처리 실행은 기존 수단으로 갈라진다:
// 재생산=A/S 케이스 핸드오프(asCaseId), 환불=주문 환불 기록(od_refund_price 가 정본,
// 여기는 협의 금액 기록만), 안내=회신 종결. 스펙 1건=보드 1종이라 BOM 의 품목 테이블
// 대신 수량 스칼라(orderedQty/affectedQty)를 쓴다. 첨부는 sp_file
// refType 'sp_pcb_claim'(고객 CUSTOMER / 관리자 대리 ADMIN — 케이스 첨부 규약 동형).
model SpPcbClaim {
  id              BigInt            @id @default(autoincrement())
  specId          BigInt
  mbId            String            @db.VarChar(60) // 고객(주문자) — spec.mbId 박제
  odId            String            @db.VarChar(64)
  ctId            Int
  /** 열린 클레임 1건 규칙 — 'pcb:{specId}' UNIQUE, 종결(resolve/reject) 시 null 로 해제. */
  activeKey       String?           @unique @db.VarChar(96)
  status          String            @default("open") @db.VarChar(16) // open|reviewing|resolved|rejected
  kind            String            @db.VarChar(24) // quality|damaged|spec_mismatch|shortage|other
  description     String            @db.Text // 고객 증상 설명(대리 접수 시 관리자 타이핑)
  orderedQty      Int // spec.qty 박제(스냅샷)
  affectedQty     Int // 불량(문제) 수량 — 전량이면 orderedQty 와 동일
  requestedRemedy String            @db.VarChar(24) // reproduce|refund|consult — 고객 희망(참고값)
  orderSnapshot   Json
  version         Int               @default(1)
  createdByRole   String            @db.VarChar(12) // customer|admin(대리 접수 — 여정 12호 byRole 관례)
  createdBy       String            @db.VarChar(191) // 작성자 mbId(고객 또는 관리자)
  adminMbId       String?           @db.VarChar(191)
  adminResponse   String?           @db.Text // 판정 회신 — 고객 노출·메일 동봉
  faultType       String?           @db.VarChar(24) // manufacturing|customer_data|shipping_damage|unknown
  resolutionKind  String?           @db.VarChar(24) // reproduce|refund_coordination|guidance
  chargeAmount    Int? // 유상 청구 기록(원) — 실청구는 별도(기록만, 08-15 결정)
  refundAmount    Int? // 환불 협의 기록(원) — 실집행 정본은 od_refund_price
  returnRequired  Boolean           @default(false) // 불량품 회수 필요(자유 기록 — 역물류 모델 보류)
  returnNote      String?           @db.VarChar(500) // 회수 운송장 등 메모
  /** 재생산 핸드오프 — resolve(reproduce)가 만든 A/S 케이스. FK 없는 느슨한 참조
   *  (케이스 삭제는 draft 뿐이라 고아가 돼도 표시만 비면 된다). */
  asCaseId        BigInt?
  submittedAt     DateTime          @default(now())
  reviewStartedAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  spec            SpOrderSpec       @relation(fields: [specId], references: [id], onDelete: Cascade)
  events          SpPcbClaimEvent[]

  @@index([specId, submittedAt])
  @@index([mbId, submittedAt]) // 고객 내역
  @@index([status, submittedAt]) // 관리자 워크큐
  @@map("sp_pcb_claim")
}

// 클레임 상태 전이 append-only 감사 이력(BOM sp_bom_claim_event 미러) — 현재 상태의
// 정본은 claim.status 고, 이 원장은 누가 언제 어떤 회신으로 전이했는지의 근거다.
model SpPcbClaimEvent {
  id         BigInt     @id @default(autoincrement())
  claimId    BigInt
  action     String     @db.VarChar(24) // submitted|review_started|resolved|rejected
  actorRole  String     @db.VarChar(12) // customer|admin
  actorMbId  String     @db.VarChar(191)
  fromStatus String?    @db.VarChar(16)
  toStatus   String     @db.VarChar(16)
  note       String?    @db.Text
  createdAt  DateTime   @default(now())
  claim      SpPcbClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("sp_pcb_claim_event")
}

// PCB 선적(P3) — 발주서당 1건 생성 + 발송 시점 묶기(sp_pcb_shipment_po, BOM §6.10
// 검증 모델). 레거시 sp_shipment(order_type 공용 — id 충돌 함정 L4)를 전용 테이블로
// 교정. 모드·받는측은 **생성 시 박제**: receiverKind admin(관리자/직송)|md(MD 입고).
// 상태 코드사전·핑퐁 주체는 BOM 선적 계약(BOM_SHIPMENT_*)을 그대로 공유한다(§8 V6).
model SpPcbShipment {
  id                 BigInt    @id @default(autoincrement())
  poId               BigInt    @unique // 대표(생성) 발주서
  // 대표의 스펙(워크큐 조회 편의) + **삭제 cascade 앵커**. 관계가 없던 동안 스펙을
  // 영구 삭제하면 RFQ·발주는 cascade 로 사라지는데 선적만 남아, 선적 워크큐에
  // 조작 불가능한 유령 행으로 영구히 떴다(2026-08-06 실측 → 관계 신설).
  specId             BigInt
  spec               SpOrderSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  mode               String    @default("international") @db.VarChar(16) // international|domestic
  status             String    @db.VarChar(20) // BOM 코드사전(preparing|requested|…|delivered)
  receiverKind       String    @default("admin") @db.VarChar(8) // admin|md
  receiverPartnerId  BigInt? // md 입고일 때 MD 조직
  destinationCountry String?   @db.VarChar(2) // 직송 박제(대표 발주서 승계, D5)
  // 운송수단(2026-08-16) — air|sea, **국제 전용**(mode 와 직교: 국경/운반수단). null 은
  // 미선택(이 축 도입 전 데이터·국내)이며 읽는 쪽이 'air' 로 접는다. 컬럼 default 를
  // 안 두는 이유 = "명시적 항공"과 "구 데이터"를 나중에 가를 수 있게.
  transport          String?   @db.VarChar(8)
  carrier            String?   @db.VarChar(50)
  trackingNumber     String?   @db.VarChar(100)
  trackingUrl        String?   @db.VarChar(500)
  shipDate           DateTime? // 출고예정일(보내는측)
  // 발송 참조번호(Case ID) 핑퐁 — 협력사가 부치기 전에 수취인 측 참조값(특송 계정·
  // 포워더 부킹·통관 참조)이 필요한 실무. 요청은 보내는측, 입력은 받는측(관리자).
  // 요청됐는데 미입력이면 국제 '선적' 전이가 게이트된다(CASE_REF_REQUIRED).
  caseRefRequestedAt DateTime? // 협력사 요청 시각 — non-null 이 곧 '요청됨'
  caseRefNote        String?   @db.VarChar(255) // 요청 메모(무엇이 필요한지)
  caseRef            String?   @db.VarChar(100) // 관리자가 입력한 참조번호
  caseRefFilledAt    DateTime?
  shippedAt          DateTime? // 최초 발송 전이 박제
  receivedAt         DateTime? // 받는측 입고확인(검수)
  receivedNote       String?   @db.Text
  completedAt        DateTime? // 최종 단계 진입 박제(revert 이탈 시 해제)
  shipQty            Int? // 발송 수량 기록(레거시 ship_qty — UI 후속)
  invoiceData        Json? // 상업송장 편집본(BomInvoiceData — D23 동형)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  pos                SpPcbShipmentPo[]
  packages           SpPcbPackage[]

  @@index([specId])
  @@map("sp_pcb_shipment")
}

// 선적:발주서 = 1:N 소속의 진실 조인(발주서는 최대 1개 선적 소속).
model SpPcbShipmentPo {
  id         BigInt        @id @default(autoincrement())
  shipmentId BigInt
  poId       BigInt        @unique
  createdAt  DateTime      @default(now())
  shipment   SpPcbShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("sp_pcb_shipment_po")
}

// PCB Case QR — BOM의 부품 포장 QR과 달리 수량 분할·LOT/DATE CODE를 다루지 않는다.
// 합배송 박스에는 서로 다른 고객의 PO가 함께 들어갈 수 있으므로 추적 단위는
// `선적 박스 × PO(견적/주문 건)` 1개다. token은 식별자일 뿐 권한이 아니며 조회 API는
// 관리자 인증을 별도로 강제한다. 같은 건 재인쇄는 token을 유지하고 이벤트만 누적한다.
model SpPcbPackage {
  id         BigInt              @id @default(autoincrement())
  shipmentId BigInt
  poId       BigInt
  token      String              @unique @db.Char(64)
  labelCode  String              @unique @db.VarChar(24)
  status     String              @default("prepared") @db.VarChar(16) // prepared|received|voided
  printedAt  DateTime?
  receivedAt DateTime?
  voidedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  shipment   SpPcbShipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  po         SpPcbPo             @relation(fields: [poId], references: [id], onDelete: Cascade)
  events     SpPcbPackageEvent[]

  @@unique([shipmentId, poId])
  @@index([poId, status])
  @@index([shipmentId, status])
  @@map("sp_pcb_package")
}

// PCB QR append-only 이력 — QR 생성·인쇄·선적 입고 동기화·박스 제외 무효화를 남긴다.
model SpPcbPackageEvent {
  id         BigInt       @id @default(autoincrement())
  packageId  BigInt
  eventType  String       @db.VarChar(16) // created|printed|received|voided
  actorType  String       @db.VarChar(16) // ADMIN|PARTNER|SYSTEM
  actorMbId  String?      @db.VarChar(191)
  fromStatus String?      @db.VarChar(16)
  toStatus   String?      @db.VarChar(16)
  note       String?      @db.Text
  occurredAt DateTime     @default(now())
  package    SpPcbPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, occurredAt])
  @@map("sp_pcb_package_event")
}
